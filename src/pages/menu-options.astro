      transform: translateY(12px);
      transition:
        opacity 160ms ease,
        transform 160ms ease;
    }

    /* ══════════════ 2 · Editorial takeover ══════════════ */
    .m2:is([data-open], [data-closing]) .ph-head {
      z-index: 40;
    }
    .m2 .ph-head {
      transition:
        background-color 300ms ease 260ms,
        border-color 300ms ease,
        color 300ms ease 160ms;
    }
    :is(.m2, .m4, .m10)[data-open] .ph-head {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
    .m2[data-open] .ph-head {
      border-color: transparent;
      background: transparent;
      color: #fff;
      transition:
        background-color 200ms ease,
        border-color 200ms ease,
        color 300ms ease 120ms;
    }
    .tg2 {
      gap: 10px;
      padding: 0 8px 0 12px;
      font-size: 12.5px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .plus {
      position: relative;
      width: 14px;
      height: 14px;
      transition: transform 560ms var(--ios);
    }
    .plus i {
      position: absolute;
      top: 6.25px;
      left: 0;
      width: 14px;
      height: 1.5px;
      border-radius: 2px;
      background: currentColor;
    }
    .plus i + i {
      transform: rotate(90deg);
    }
    .tg2[aria-expanded='true'] .plus {
      transform: rotate(135deg);
    }
    .p2 {
      inset: 0;
      z-index: 35;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 24px;
      padding: 96px 22px 24px;
      overflow-y: auto;
      scrollbar-width: none;
      background: var(--color-ink);
      color: #fff;
      clip-path: inset(0 0 100% 0);
      transition: clip-path 480ms var(--swift) 140ms;
    }
    .m2[data-open] .p2 {
      clip-path: inset(0 0 0 0);
      transition: clip-path 760ms cubic-bezier(0.76, 0, 0.24, 1);
    }
    .p2-list li {
      border-top: 1px solid rgb(255 255 255 / 0.14);
    }
    .p2-link {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      padding: 12px 0 8px;
      font-size: 2.75rem;
      line-height: 0.92;
      text-decoration: none;
    }
    .p2-mask {
      display: block;
      overflow: hidden;
      padding-bottom: 0.06em;
    }
    .p2-word {
      display: block;
      transform: translateY(110%);
      transition:
        transform 260ms var(--ios-in),
        color var(--dur) var(--ease-out);
    }
    .m2[data-open] .p2-word {
      transform: none;
      transition:
        transform 860ms var(--ios) calc(300ms + var(--i) * 70ms),
        color var(--dur) var(--ease-out);
    }
    .p2-num,
    .p2-how,
    .p2-foot {
      opacity: 0;
      transition: opacity 200ms ease;
    }
    .p2-num {
      margin-top: 4px;
      font-family: var(--font-body);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.06em;
      color: rgb(255 255 255 / 0.5);
    }
    .m2[data-open] :is(.p2-num, .p2-how, .p2-foot) {
      opacity: 1;
      transition: opacity 500ms ease calc(520ms + var(--i, 4) * 70ms);
    }
    @media (hover: hover) {
      .p2-link:hover .p2-word {
        color: var(--color-accent-tint);
      }
    }
    .p2-how {
      display: flex;
      align-items: center;
      gap: 10px;
      min-height: 52px;
      border-top: 1px solid rgb(255 255 255 / 0.14);
      font-size: 15px;
      font-weight: 500;
      text-decoration: none;
      color: rgb(255 255 255 / 0.8);
    }
    .p2-foot {
      display: grid;
      gap: 18px;
      justify-items: start;
    }
    .p2-tt {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      height: 48px;
      padding: 0 20px 0 16px;
      border-radius: var(--radius-pill);
      background: var(--color-accent);
      color: var(--color-on-accent);
      font-size: var(--text-sm);
      font-weight: 600;
      text-decoration: none;
    }
    .p2-biz {
      display: grid;
