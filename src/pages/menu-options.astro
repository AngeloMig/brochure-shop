        border-radius: 24px;
      }
    }
    .p3-drag {
      position: sticky;
      top: 0;
      z-index: 1;
      margin: 0 -12px;
      padding: 0 12px;
      background: #fff;
      touch-action: none;
      cursor: grab;
    }
    .p3-grab {
      display: block;
      width: 38px;
      height: 5px;
      margin: 8px auto 2px;
      border-radius: 3px;
      background: var(--color-panel-strong);
    }
    .p3-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 0 4px 8px;
    }
    .p3-title {
      font-size: 17px;
      font-weight: 600;
    }
    .p3-x {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--color-panel);
      transition: background-color var(--dur) var(--ease-out);
    }
    .p3-x:hover {
      background: var(--color-panel-strong);
    }
    .p3-list li {
      opacity: 0;
      transform: translateY(18px);
      transition:
        opacity 160ms ease,
        transform 200ms ease;
    }
    .m3[data-open] :is(.p3-list li, .p3-quick li) {
      opacity: 1;
      transform: none;
      transition:
        opacity 420ms ease calc(140ms + var(--i) * 40ms),
        transform 680ms var(--ios) calc(140ms + var(--i) * 40ms);
    }
    .p3-list li + li .p3-row {
      border-top: 1px solid var(--color-border);
    }
    .p3-row {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      column-gap: 12px;
      min-height: 64px;
      margin: 0 8px;
      padding: 10px 0;
      text-decoration: none;
    }
    .p3-row__t {
      font-size: 1.35rem;
      line-height: 1.05;
    }
    .p3-row__h {
      grid-row: 2;
      color: var(--color-muted);
