      text-underline-offset: 3px;
    }
    .p2-label {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgb(255 255 255 / 0.5);
    }

    /* ══════════════ 3 · Thumb sheet ══════════════ */
    .tg3 {
      height: 44px;
      padding: 0 16px 0 18px;
      border-radius: var(--radius-pill);
      background: var(--color-panel);
    }
    .lines--3 {
      height: 11px;
    }
    .lines--3 i:nth-child(2) {
      top: 5px;
      right: 4px;
    }
    .lines--3 i:last-child {
      top: 9px;
    }
    .tg[aria-expanded='true'] .lines i:nth-child(2):not(:last-child) {
      opacity: 0;
    }
    .tg[aria-expanded='true'] .lines--3 i:first-child,
    .tg[aria-expanded='true'] .lines--3 i:last-child {
      top: 4.75px;
    }
    .tg[aria-expanded='true'] .lines--8 i:first-child,
    .tg[aria-expanded='true'] .lines--8 i:last-child {
      top: 5.25px;
    }
    .m3 .ph-scrim {
      z-index: 45;
    }
    .p3 {
      left: 6px;
      right: 6px;
      bottom: 6px;
      z-index: 50;
      max-height: calc(100% - 52px);
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: none;
      padding: 0 12px 12px;
      border-radius: 34px;
      background: #fff;
      box-shadow: 0 -12px 40px -12px rgb(28 29 26 / 0.3);
      transform: translateY(calc(100% + 16px));
      transition: transform 440ms var(--ios);
    }
    .m3[data-open] .p3 {
      transform: none;
      transition: transform 620ms var(--ios);
    }
    @media (max-width: 599px) {
