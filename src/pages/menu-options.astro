---
import { withBase } from '../lib/paths';
/**
 * Preview page: ten mobile hamburger-menu concepts to choose from.
 * Visit /menu-options. Not linked from the site and hidden from search.
 *
 * Every option is a live phone frame with a mini catalog inside: tap the menu
 * button to open it, tap again / the scrim / Esc to close. All positioning is
 * contained in the frame (absolute, never fixed). Once one is chosen it moves
 * into Header.astro and this page can be deleted.
 */
import '@fontsource/instrument-serif/latin-400-italic.css';
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
import { products, categories } from '../data/products';

const handle = site.tiktokHandle;
const tiktok = site.tiktokProfileUrl;
const phoneNo = site.contact.whatsapp;
const digits = phoneNo.replace(/\D/g, '');
const wa = `https://wa.me/${digits}`;
const viber = `viber://chat?number=%2B${digits}`;
const email = site.contact.email;
const mail = `mailto:${email}`;

const phpFmt = new Intl.NumberFormat('en-PH', { style: 'currency', currency: 'PHP', maximumFractionDigits: 0 });
const php = (usd: number) => `≈ ${phpFmt.format(usd * site.currency.usdToPhp)}`;
const byId = (id: string) => products.find((x) => x.id === id)!;

const hints: Record<string, string> = {
  Featured: 'Top picks right now',
  'All Finds': 'Every product, by category',
  Videos: 'Watch them on TikTok',
  About: 'Who’s behind bea',
  'How buying works': 'Prices, shipping & returns',
};
const nav = [...site.nav, ...site.footerNav].map((l) => ({ ...l, hint: hints[l.label] ?? '' }));
const main = nav.slice(0, 4);
const how = nav[4];

const cards = [
  { id: 'athena-body-wash', short: 'Athena Body Wash' },
  { id: 'grace-glow-rouge-540', short: 'Rouge 540 Body Wash' },
  { id: 'grace-glow-english-pear', short: 'English Pear Body Wash' },
].map((c) => ({ name: c.short, img: withBase(`/images/products/${c.id}.webp`), price: php(byId(c.id).price ?? 0) }));

const pick = byId('athena-body-wash');
const pickPrice = php(pick.price ?? 0);

const cats = categories.map((name) => ({ name, count: products.filter((p) => p.category === name).length }));
const totalFinds = products.length;

const contacts = [
  { label: 'WhatsApp', href: wa, icon: 'chat' },
  { label: 'Viber', href: viber, icon: 'phone' },
  { label: 'Email', href: mail, icon: 'mail' },
] as const;

const ico = {
  play: '<svg viewBox="0 0 8 10" width="8" height="10" aria-hidden="true"><path d="M0 0v10l8-5z" fill="currentColor"/></svg>',
  arrow:
    '<svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true"><path d="M1 7h11M7.5 2.5 12 7l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  ext: '<svg viewBox="0 0 12 12" width="11" height="11" aria-hidden="true"><path d="M3 9 9 3M4 3h5v5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  close:
    '<svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true"><path d="M1.5 1.5l11 11M12.5 1.5l-11 11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
  tiktok:
    '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5c-1.42 0-2.6-1.16-2.6-2.6 0-1.72 1.66-3.01 3.37-2.48V9.66c-3.45-.46-6.47 2.22-6.47 5.64 0 3.33 2.76 5.7 5.69 5.7 3.14 0 5.69-2.55 5.69-5.7V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3s-1.88.09-3.24-1.48Z"/></svg>',
  chat: '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 11.6a8.1 8.1 0 0 1-11.9 7.1L4 20l1.4-3.9A8.1 8.1 0 1 1 20 11.6Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9.2 8.6c.3 2.6 2.4 4.9 5.2 5.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
  phone:
    '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M7 3.8h2.4l1.3 3.8-1.8 1.2a10.4 10.4 0 0 0 6.3 6.3l1.2-1.8 3.8 1.3V17a2 2 0 0 1-2.2 2A15.2 15.2 0 0 1 5 6a2 2 0 0 1 2-2.2Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>',
  mail: '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="3.5" y="5.5" width="17" height="13" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="m4.5 7.5 7.5 5.5 7.5-5.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>',
  search:
    '<svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.75" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="m13 13 4.5 4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>',
  chevron:
    '<svg viewBox="0 0 12 8" width="11" height="7" aria-hidden="true"><path d="m1 1.5 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>',
};

const options = [
  {
    n: 1,
    name: 'Refined pill',
    note: 'Today’s menu, polished. The bar floats into a frosted oval, the card unrolls from under it and the links rise in turn. The smallest change and the most familiar.',
    keep: true,
  },
  {
    n: 2,
    name: 'Editorial takeover',
    note: 'A charcoal curtain drops over the page and huge links rise line by line, like a magazine. TikTok and the business contact sit at the bottom.',
    keep: true,
  },
  {
    n: 3,
    name: 'Thumb sheet',
    note: 'The menu slides up from the bottom, within thumb reach: big rows with a hint under each, plus one-tap TikTok, WhatsApp, Viber and email. Drag the handle down to close.',
    keep: false,
  },
  {
    n: 4,
    name: 'Ruby reveal',
    note: 'A round button that the menu grows out of, as a ruby circle filling the screen. Bold and playful: the one place the accent goes big.',
    keep: true,
  },
  {
    n: 5,
    name: 'Menu + top pick',
    note: 'A drop-down with the links on one side and today’s top pick on the other, so the menu also sells. The pick can change as often as you like.',
    keep: true,
  },
  {
    n: 6,
    name: 'Morphing pill',
    note: 'The Menu pill itself stretches into the panel and shrinks back on close, so button and menu feel like one object. Dark, compact, app-like.',
    keep: true,
  },
  {
    n: 7,
    name: 'Shop by category',
    note: 'Search and the six categories come first, then the page links. Best if most visitors arrive looking for a type of product.',
    keep: true,
  },
  {
    n: 8,
    name: 'Drawer, 3D tilt',
    note: 'A drawer of stacked link cards slides in from the right while the page tilts back behind it. Tap the page edge or × to return.',
    keep: false,
  },
  {
    n: 9,
    name: 'The dot',
    note: 'The ruby dot in “bea.” is the menu button. Tapping it blooms into a small floating bubble with the links. The quietest header possible.',
    keep: true,
  },
  {
    n: 10,
    name: 'Serif ticker',
    note: 'The logo’s italic serif, set large: links slide in one by one over a slow “bea.” marquee in ruby. The most on-brand of the ten.',
    keep: true,
  },
];
---

<Base noindex title="Mobile menu options — bea">
  <div class="lab">
    <header class="lab__head">
      <p class="eyebrow">Preview</p>
      <h1 class="display lab__title">Mobile menu — 10 options</h1>
      <p class="lede">
        Each phone is live. Tap its menu button to open the menu, then tap the button again, the dimmed page or press
        Esc to close. Every option has the five links, a way to follow on TikTok and a clear close. Tell me the number
        you like.
      </p>
    </header>

    <nav class="jump" aria-label="Jump to option">
      {options.map((o) => <a href={`#option-${o.n}`}>{o.n}</a>)}
    </nav>

    <div class="grid">
      {
        options.map((o) => (
          <section class="opt" id={`option-${o.n}`} aria-labelledby={`opt-name-${o.n}`}>
            <div class="opt__meta">
              <h2 id={`opt-name-${o.n}`} class="opt__name">
                <span class="opt__num">{o.n}</span> {o.name}
              </h2>
              <p class="opt__note">{o.note}</p>
            </div>

            <div class={`phone m${o.n}`} data-phone data-keep-toggle={o.keep ? '' : undefined}>
              <div class="ph-screen" data-screen>
                <div class="ph-world" data-world>
                  <header class="ph-head">
                    {o.n === 9 ? (
                      <span class="m9-brand">
                        <a class="ph-mark" href="#top" data-demo aria-label="bea home">
                          <span class="ph-mark__w">bea</span>
                        </a>
                        <button
                          class="tg tg9"
                          type="button"
                          aria-expanded="false"
                          aria-controls="m9-menu"
                          aria-label="Menu"
                          data-toggle
                        >
                          <span class="tg9__ring" aria-hidden="true" />
                          <span class="tg9__dot" aria-hidden="true">
                            <span class="tg9__x">
                              <i />
                              <i />
                            </span>
                          </span>
                        </button>
                      </span>
                    ) : (
                      <a class="ph-mark" href="#top" data-demo aria-label="bea home">
                        <span class="ph-mark__w">
                          bea
                          <i class="ph-mark__dot" />
                        </span>
                      </a>
                    )}

                    {(o.n === 1 || o.n === 6) && (
                      <button
                        class={`tg tg-ink tg${o.n}`}
                        type="button"
                        aria-expanded="false"
                        aria-controls={`m${o.n}-menu`}
                        aria-label="Menu"
                        data-toggle
                      >
                        <span class="roll" aria-hidden="true">
                          <span>Menu</span>
                          <span>Close</span>
                        </span>
                        <span class="lines" aria-hidden="true">
                          <i />
                          <i />
                        </span>
                      </button>
                    )}
                    {o.n === 2 && (
                      <button class="tg tg2" type="button" aria-expanded="false" aria-controls="m2-menu" aria-label="Menu" data-toggle>
                        <span class="roll" aria-hidden="true">
                          <span>Menu</span>
                          <span>Close</span>
                        </span>
                        <span class="plus" aria-hidden="true">
                          <i />
                          <i />
                        </span>
                      </button>
                    )}
                    {o.n === 3 && (
                      <button class="tg tg3" type="button" aria-expanded="false" aria-controls="m3-menu" aria-label="Menu" data-toggle>
                        <span>Menu</span>
                        <span class="lines lines--3" aria-hidden="true">
                          <i />
                          <i />
                          <i />
                        </span>
                      </button>
                    )}
                    {o.n === 4 && (
                      <button class="tg tg4" type="button" aria-expanded="false" aria-controls="m4-menu" aria-label="Menu" data-toggle>
                        <span class="lines" aria-hidden="true">
                          <i />
                          <i />
                        </span>
                      </button>
                    )}
                    {o.n === 5 && (
                      <button class="tg tg5" type="button" aria-expanded="false" aria-controls="m5-menu" aria-label="Menu" data-toggle>
                        <span>Menu</span>
                        <span class="ico tg5__chev">
                          <Fragment set:html={ico.chevron} />
                        </span>
                      </button>
                    )}
                    {o.n === 7 && (
                      <button class="tg tg7" type="button" aria-expanded="false" aria-controls="m7-menu" aria-label="Menu" data-toggle>
                        <span class="tg7__icons" aria-hidden="true">
                          <span class="ico tg7__search">
                            <Fragment set:html={ico.search} />
                          </span>
                          <span class="ico tg7__x">
                            <Fragment set:html={ico.close} />
                          </span>
                        </span>
                        <span class="roll" aria-hidden="true">
                          <span>Menu</span>
                          <span>Close</span>
                        </span>
                      </button>
                    )}
                    {o.n === 8 && (
                      <button class="tg tg8" type="button" aria-expanded="false" aria-controls="m8-menu" aria-label="Menu" data-toggle>
                        <span class="lines lines--8" aria-hidden="true">
                          <i />
                          <i />
                          <i />
                        </span>
                      </button>
                    )}
                    {o.n === 10 && (
                      <button class="tg tg10" type="button" aria-expanded="false" aria-controls="m10-menu" aria-label="Menu" data-toggle>
                        <span class="roll roll--serif" aria-hidden="true">
                          <span>
                            Menu<i />
                          </span>
                          <span>
                            Close<i />
                          </span>
                        </span>
                      </button>
                    )}
                  </header>

                  {/* Mini catalog behind the menu (decorative) */}
                  <div class="ph-page" data-page aria-hidden="true">
                    <div class="fp-hero">
                      <img src={withBase('/images/hero.jpg')} alt="" loading="lazy" />
                      <div class="fp-hero__text">
                        <p class="fp-eyebrow">@{handle}</p>
                        <p class="display fp-h">My favorite finds, all in one place.</p>
                        <span class="fp-pill">Explore my finds</span>
                      </div>
                    </div>
                    <div class="fp-sec">
                      <p class="display fp-h2">Top picks right now</p>
                      <div class="fp-grid">
                        {cards.map((c) => (
                          <div class="fp-card">
                            <div class="fp-img">
                              <img src={c.img} alt="" loading="lazy" />
                            </div>
                            <p class="fp-name">{c.name}</p>
                            <p class="fp-price">{c.price}</p>
                          </div>
                        ))}
                        <div class="fp-card">
                          <div class="fp-img fp-img--more">
                            <span>See all {totalFinds} finds</span>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="fp-sec">
                      <p class="display fp-h2">Watch on TikTok</p>
                      <div class="fp-vids">
                        {cards.map((c) => (
                          <div class="fp-vid">
                            <img src={c.img} alt="" loading="lazy" />
                            <span class="fp-vid__play">
                              <Fragment set:html={ico.play} />
                            </span>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>

                <div class="ph-scrim" data-scrim />

                {/* ───────────── 1 · Refined pill ───────────── */}
                {o.n === 1 && (
                  <div class="panel p1" id="m1-menu" data-panel hidden>
                    <nav aria-label="Menu">
                      <ul role="list" class="p1-list">
                        {main.map((l, i) => (
                          <li style={`--i:${i}`}>
                            <a class="display p1-link" href={l.href} data-demo>
                              {l.label}
                              <span class="ico">
                                <Fragment set:html={ico.play} />
                              </span>
                            </a>
                          </li>
                        ))}
                        <li style="--i:4">
                          <a class="p1-how" href={how.href} data-demo>
                            {how.label}
                            <span class="ico">
                              <Fragment set:html={ico.arrow} />
                            </span>
                          </a>
                        </li>
                      </ul>
                    </nav>
                    <a class="p1-follow" style="--i:5" href={tiktok} target="_blank" rel="noopener">
                      <span class="ico">
                        <Fragment set:html={ico.tiktok} />
                      </span>
                      Follow @{handle} on TikTok
                      <span class="visually-hidden"> (opens in a new tab)</span>
                    </a>
                  </div>
                )}

                {/* ───────────── 2 · Editorial takeover ───────────── */}
                {o.n === 2 && (
                  <div class="panel p2" id="m2-menu" data-panel hidden>
                    <nav aria-label="Menu">
                      <ol role="list" class="p2-list">
                        {main.map((l, i) => (
                          <li style={`--i:${i}`}>
                            <a class="display p2-link" href={l.href} data-demo>
                              <span class="p2-mask">
                                <span class="p2-word">{l.label}</span>
                              </span>
                              <span class="p2-num">0{i + 1}</span>
                            </a>
                          </li>
                        ))}
                      </ol>
                      <a class="p2-how" href={how.href} data-demo>
                        {how.label}
                        <span class="ico">
                          <Fragment set:html={ico.arrow} />
                        </span>
                      </a>
                    </nav>
                    <div class="p2-foot">
                      <a class="p2-tt" href={tiktok} target="_blank" rel="noopener">
                        <span class="ico">
                          <Fragment set:html={ico.tiktok} />
                        </span>
                        Follow @{handle}
                        <span class="visually-hidden"> on TikTok (opens in a new tab)</span>
                      </a>
                      <div class="p2-biz">
                        <p class="p2-label">For business</p>
                        <p>
                          <a href={wa} target="_blank" rel="noopener">
                            WhatsApp
                          </a>{' '}
                          ·{' '}
                          <a href={viber}>Viber</a> · {phoneNo}
                        </p>
                        <p>
                          <a href={mail}>{email}</a>
                        </p>
                      </div>
                    </div>
                  </div>
                )}

                {/* ───────────── 3 · Thumb sheet ───────────── */}
                {o.n === 3 && (
                  <div class="panel p3" id="m3-menu" data-panel hidden role="dialog" aria-label="Menu">
                    <div class="p3-drag" data-drag>
                      <span class="p3-grab" aria-hidden="true" />
                      <div class="p3-top">
                        <p class="p3-title">Menu</p>
                        <button class="p3-x" type="button" data-close aria-label="Close menu">
                          <Fragment set:html={ico.close} />
                        </button>
                      </div>
                    </div>
                    <nav aria-label="Menu">
                      <ul role="list" class="p3-list">
                        {nav.map((l, i) => (
                          <li style={`--i:${i}`}>
                            <a class="p3-row" href={l.href} data-demo data-autofocus={i === 0 ? '' : undefined}>
                              <span class="display p3-row__t">{l.label}</span>
                              <span class="p3-row__h">{l.hint}</span>
                              <span class="ico p3-row__go">
                                <Fragment set:html={ico.arrow} />
                              </span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </nav>
                    <ul role="list" class="p3-quick" aria-label="Quick actions">
                      <li style="--i:5">
                        <a class="p3-q p3-q--tt" href={tiktok} target="_blank" rel="noopener">
                          <span class="p3-q__ico">
                            <Fragment set:html={ico.tiktok} />
                          </span>
                          Follow
                          <span class="visually-hidden"> @{handle} on TikTok (opens in a new tab)</span>
                        </a>
                      </li>
                      {contacts.map((c, i) => (
                        <li style={`--i:${6 + i}`}>
                          <a class="p3-q" href={c.href} target={c.icon === 'chat' ? '_blank' : undefined} rel="noopener">
                            <span class="p3-q__ico">
                              <Fragment set:html={ico[c.icon]} />
                            </span>
                            {c.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {/* ───────────── 4 · Ruby reveal ───────────── */}
                {o.n === 4 && (
                  <div class="panel p4" id="m4-menu" data-panel hidden>
                    <nav aria-label="Menu">
                      <ul role="list" class="p4-list">
                        {main.map((l, i) => (
                          <li style={`--i:${i}`}>
                            <a class="display p4-link" href={l.href} data-demo>
                              {l.label}
                              <span class="ico">
                                <Fragment set:html={ico.play} />
                              </span>
                            </a>
                          </li>
                        ))}
                        <li style="--i:4">
                          <a class="p4-how" href={how.href} data-demo>
                            {how.label}
                            <span class="ico">
                              <Fragment set:html={ico.arrow} />
                            </span>
                          </a>
                        </li>
                      </ul>
                    </nav>
                    <div class="p4-foot">
                      <a class="p4-tt" href={tiktok} target="_blank" rel="noopener">
                        <span class="ico">
                          <Fragment set:html={ico.tiktok} />
                        </span>
                        Follow @{handle}
                        <span class="visually-hidden"> on TikTok (opens in a new tab)</span>
                      </a>
                      <p class="p4-biz">
                        Business: <a href={wa} target="_blank" rel="noopener">WhatsApp</a> ·{' '}
                        <a href={viber}>Viber</a> · <a href={mail}>Email</a>
                      </p>
                    </div>
                  </div>
                )}

                {/* ───────────── 5 · Menu + top pick ───────────── */}
                {o.n === 5 && (
                  <div class="panel p5" id="m5-menu" data-panel hidden>
                    <div class="p5-grid">
                      <nav aria-label="Menu">
                        <ul role="list" class="p5-list">
                          {nav.map((l, i) => (
                            <li style={`--i:${i}`}>
                              <a class={`p5-link ${i < 4 ? 'display' : 'p5-link--how'}`} href={l.href} data-demo>
                                {l.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </nav>
                      <article class="p5-pick" aria-labelledby="m5-pick-name">
                        <div class="p5-pick__img">
                          <img src={withBase('/images/products/athena-body-wash.webp')} alt="" loading="lazy" />
                        </div>
                        <p class="p5-pick__eyebrow">
                          <i aria-hidden="true" />
                          Today’s top pick
                        </p>
                        <h3 id="m5-pick-name" class="p5-pick__name">
                          {pick.name}
                        </h3>
                        <p class="p5-pick__price">
                          {pickPrice}
                          <span>Final price on TikTok</span>
                        </p>
                        <a class="p5-pick__cta" href="https://www.tiktok.com/shop" target="_blank" rel="noopener">
                          View on TikTok
                          <span class="visually-hidden"> (opens in a new tab)</span>
                        </a>
                      </article>
                    </div>
                    <a class="p5-follow" href={tiktok} target="_blank" rel="noopener">
                      <span class="ico">
                        <Fragment set:html={ico.tiktok} />
                      </span>
                      Follow @{handle} on TikTok
                      <span class="visually-hidden"> (opens in a new tab)</span>
                    </a>
                  </div>
                )}

                {/* ───────────── 6 · Morphing pill ───────────── */}
                {o.n === 6 && (
                  <div class="panel p6" id="m6-menu" data-panel hidden>
                    <span class="p6-mark" aria-hidden="true">
                      <span>
                        bea<i />
                      </span>
                    </span>
                    <nav aria-label="Menu">
                      <ul role="list" class="p6-list">
                        {main.map((l, i) => (
                          <li style={`--i:${i}`}>
                            <a class="display p6-link" href={l.href} data-demo>
                              {l.label}
                              <span class="ico">
                                <Fragment set:html={ico.play} />
                              </span>
                            </a>
