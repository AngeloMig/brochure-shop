    /* ── Shared toggle parts ──────────────────────────────────────────── */
    .tg {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      flex: none;
      min-width: 44px;
      min-height: 44px;
      font-size: var(--text-sm);
      font-weight: 500;
      transition:
        transform 160ms var(--ease-out),
        background-color 360ms var(--ios),
        color 360ms var(--ios),
        box-shadow 360ms var(--ios);
    }
    .tg:active {
      transform: scale(0.96);
    }
    .roll {
      display: grid;
      height: 1.4em;
      overflow: hidden;
      line-height: 1.4;
    }
    .roll > span {
      grid-area: 1 / 1;
      transition: transform 560ms var(--ios);
    }
    .roll > span + span {
      transform: translateY(100%);
    }
    .tg[aria-expanded='true'] .roll > span:first-child {
      transform: translateY(-100%);
    }
    .tg[aria-expanded='true'] .roll > span + span {
      transform: none;
    }
    .lines {
      position: relative;
      width: 16px;
      height: 10px;
    }
    .lines i {
      position: absolute;
      left: 0;
      right: 0;
      height: 1.5px;
      border-radius: 2px;
      background: currentColor;
      transition:
        transform 480ms var(--ios),
        top 480ms var(--ios),
        opacity 240ms ease,
        width 480ms var(--ios);
    }
    .lines i:first-child {
      top: 1px;
    }
    .lines i:last-child {
      top: 7.5px;
    }
    .tg[aria-expanded='true'] .lines i:first-child {
      top: 4.25px;
      transform: rotate(45deg);
    }
    .tg[aria-expanded='true'] .lines i:last-child {
      top: 4.25px;
      transform: rotate(-45deg);
    }
