      background: var(--color-ink);
      color: var(--color-on-dark);
    }

    /* ══════════════ 4 · Ruby reveal ══════════════ */
    .tg4 {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--color-ink);
      color: #fff;
    }
    .tg4[aria-expanded='true'] {
      background: #fff;
