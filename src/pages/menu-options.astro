    .p4-how {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      min-height: 48px;
      margin-top: 6px;
      font-size: 15px;
      font-weight: 500;
      color: rgb(255 255 255 / 0.85);
      text-decoration: none;
    }
    .p4-foot {
      display: grid;
      gap: 14px;
