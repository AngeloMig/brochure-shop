    /* ── Reduced motion: every menu still works, without movement ───────── */
    @media (prefers-reduced-motion: reduce) {
      .phone *,
      .phone *::before,
      .phone *::after {
        transition-duration: 1ms !important;
        transition-delay: 0ms !important;
        animation: none !important;
      }
    }
  </style>

  <script>
    const FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])';

    type Ctl = { isOpen: () => boolean; close: (focus?: boolean) => void };
    const ctls: Ctl[] = [];

    document.querySelectorAll<HTMLElement>('[data-phone]').forEach((phone) => {
      const screen = phone.querySelector<HTMLElement>('[data-screen]')!;
      const toggle = phone.querySelector<HTMLButtonElement>('[data-toggle]')!;
      const panel = phone.querySelector<HTMLElement>('[data-panel]')!;
      const page = phone.querySelector<HTMLElement>('[data-page]')!;
      const keepToggle = phone.hasAttribute('data-keep-toggle');
      const baseLabel = toggle.getAttribute('aria-label') || 'Menu';
      let open = false;
      let token = 0;
      let timer = 0;

      /** Where the toggle sits relative to the panel: used by morph / circle / bubble origins. */
      const measure = () => {
        const s = screen.getBoundingClientRect();
        const t = toggle.getBoundingClientRect();
        const px = panel.offsetLeft;
        const py = panel.offsetTop;
        const tl = t.left - s.left;
        const tt = t.top - s.top;
        const set = (k: string, v: number) => panel.style.setProperty(k, `${Math.round(v * 10) / 10}px`);
        set('--ox', tl + t.width / 2 - px);
        set('--oy', tt + t.height / 2 - py);
        set('--t', tt - py);
        set('--l', tl - px);
        set('--r', px + panel.offsetWidth - (tl + t.width));
        set('--b', py + panel.offsetHeight - (tt + t.height));
      };

      const focusables = () =>
        [...(keepToggle ? [toggle] : []), ...panel.querySelectorAll<HTMLElement>(FOCUSABLE)].filter(
          (el) => el.getClientRects().length > 0,
        );

      const doOpen = () => {
        if (open) return;
        ctls.forEach((c) => c !== ctl && c.isOpen() && c.close(false));
        open = true;
        token++;
        clearTimeout(timer);
        panel.hidden = false;
        measure();
        void panel.offsetWidth; // commit the closed state so the open transition runs
        phone.removeAttribute('data-closing');
        phone.setAttribute('data-open', '');
        toggle.setAttribute('aria-expanded', 'true');
        toggle.setAttribute('aria-label', 'Close menu');
        requestAnimationFrame(() => {
          const first =
            panel.querySelector<HTMLElement>('[data-autofocus]') ?? panel.querySelector<HTMLElement>(FOCUSABLE);
          first?.focus({ preventScroll: true });
        });
      };

      const close = (returnFocus = true) => {
        if (!open) return;
        open = false;
        const my = ++token;
        phone.removeAttribute('data-open');
        phone.setAttribute('data-closing', '');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', baseLabel);
        if (returnFocus) toggle.focus({ preventScroll: true });
        const done = () => {
          if (my !== token) return;
          clearTimeout(timer);
          panel.hidden = true;
          phone.removeAttribute('data-closing');
        };
        const running = phone.getAnimations({ subtree: true }).filter((a) => a instanceof CSSTransition);
        Promise.all(running.map((a) => a.finished.catch(() => {}))).then(done);
        timer = window.setTimeout(done, 1500);
      };

      const ctl: Ctl = { isOpen: () => open, close };
      ctls.push(ctl);

      toggle.addEventListener('click', () => (open ? close() : doOpen()));
      phone.querySelector('[data-scrim]')?.addEventListener('click', () => close());
      phone.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', () => close()));
      panel.addEventListener('click', (e) => {
        const a = (e.target as Element).closest('a');
        if (a?.hasAttribute('data-demo')) {
          e.preventDefault();
          close();
        }
      });
      panel.querySelector('[data-search]')?.addEventListener('submit', (e) => e.preventDefault());
      page.addEventListener('scroll', () => phone.toggleAttribute('data-scrolled', page.scrollTop > 8), {
        passive: true,
      });

      // Keep Tab inside the open menu.
      phone.addEventListener('keydown', (e) => {
        if (e.key !== 'Tab' || !open) return;
        const items = focusables();
        if (!items.length) return;
        const first = items[0];
        const last = items[items.length - 1];
        const active = document.activeElement as HTMLElement;
        if (!items.includes(active)) {
          e.preventDefault();
          first.focus();
        } else if (e.shiftKey && active === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && active === last) {
          e.preventDefault();
          first.focus();
        }
      });

      // 3 · Thumb sheet: drag the handle down to dismiss.
      const drag = phone.querySelector<HTMLElement>('[data-drag]');
      if (drag) {
        let startY = 0;
        let dy = 0;
        let t0 = 0;
        let dragging = false;
        drag.addEventListener('pointerdown', (e) => {
          if (!open || (e.target as Element).closest('button')) return;
          dragging = true;
          startY = e.clientY;
          dy = 0;
          t0 = performance.now();
          drag.setPointerCapture(e.pointerId);
          panel.style.transition = 'none';
        });
        drag.addEventListener('pointermove', (e) => {
          if (!dragging) return;
          const raw = e.clientY - startY;
          dy = raw > 0 ? raw : raw / 6;
          panel.style.transform = `translateY(${dy}px)`;
        });
        const end = () => {
          if (!dragging) return;
          dragging = false;
          const v = dy / Math.max(1, performance.now() - t0);
          panel.style.removeProperty('transition');
          panel.style.removeProperty('transform');
          if (dy > 110 || (v > 0.5 && dy > 30)) close();
        };
        drag.addEventListener('pointerup', end);
        drag.addEventListener('pointercancel', end);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') ctls.filter((c) => c.isOpen()).forEach((c) => c.close(true));
    });
    // Demo links in the frame headers shouldn't jump the page.
    document
      .querySelectorAll<HTMLAnchorElement>('.ph-head a[data-demo]')
      .forEach((a) => a.addEventListener('click', (e) => e.preventDefault()));
  </script>
</Base>
