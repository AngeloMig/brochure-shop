    }
    .m4:is([data-open], [data-closing]) .ph-head {
      z-index: 40;
    }
    .m4 .ph-head {
      transition:
        background-color 260ms ease 380ms,
        border-color 260ms ease 380ms,
        color 300ms ease 200ms;
    }
    .m4[data-open] .ph-head {
      border-color: transparent;
      background: transparent;
      color: #fff;
      transition:
        background-color 160ms ease 60ms,
        border-color 160ms ease,
