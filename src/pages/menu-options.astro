    }

    /* ══════════════ 5 · Menu + top pick ══════════════ */
    .tg5 {
      height: 44px;
      padding: 0 16px 0 18px;
      border-radius: var(--radius-pill);
      background: var(--color-panel);
    }
    .tg5__chev {
      transition: transform 520ms var(--ios);
    }
    .tg5[aria-expanded='true'] {
      background: var(--color-ink);
      color: var(--color-on-dark);
