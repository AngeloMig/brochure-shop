    }
    .p3-row__go {
      grid-row: 1 / 3;
      grid-column: 2;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--color-panel);
    }
    .p3-quick {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 6px;
      margin-top: 8px;
      padding: 12px 6px 4px;
      border-radius: 24px;
      background: var(--color-panel);
    }
    .p3-quick li {
      opacity: 0;
      transform: translateY(18px);
