---
import { withBase } from '../lib/paths';
/**
 * Preview page: ten improved quick-view popup concepts to choose from.
 * Visit /quickview-options. Not linked from the site and hidden from search.
 *
 * Every option has a live popup ("Open preview", a real <dialog>) filled with
 * the Athena body wash, plus a phone + desktop mock of its open state. The
 * mocks are this same page loaded at ?mock=<n>, which shows option n open over
 * a faux catalog — so they always match the live popup exactly.
 * Once one is chosen it moves into QuickView.astro and this page can be deleted.
 */
import '@fontsource/instrument-serif/latin-400-italic.css';
import Base from '../layouts/Base.astro';
import Pill from '../components/Pill.astro';
import CurrencySwitch from '../components/CurrencySwitch.astro';
import { products } from '../data/products';
import { videos } from '../data/videos';
import { imageAttrs } from '../lib/images';
import { site } from '../config/site';

const byId = (id: string) => products.find((x) => x.id === id)!;
const p = byId('athena-body-wash');
const usd = p.price ?? 0;
const phpFmt = new Intl.NumberFormat('en-PH', { style: 'currency', currency: 'PHP', maximumFractionDigits: 0 });
const priceText = (v: number) => `≈ ${phpFmt.format(v * site.currency.usdToPhp)}`;
const price = priceText(usd);

/** TEST links for the preview — the real popup uses each product's affiliate link. */
const TEST_LINK = 'https://www.tiktok.com/shop';
const VIDEO_LINK = 'https://www.tiktok.com/';
const NOTE = 'Sample price · final price on TikTok';

const img = withBase(p.image);
const alt = p.imageAlt ?? p.name;
const ingredients = ['Niacinamide', 'Vitamin C', 'Collagen'];
const size = '400 g · 13.5 fl oz';
// Placeholder copy for the editorial option — replace with your own words.
const quote = 'The one bottle I keep repurchasing: a clean lavender scent, and skin that feels soft, never tight.';

const clips = ['candle-evening', 'bedroom-refresh']
  .map((id) => videos.find((v) => v.id === id)!)
  .map((v) => ({ caption: v.caption, thumb: imageAttrs(v.thumbnail, { ratio: 9 / 16, widths: [160] })?.src ?? '' }));

/** Gallery-first option: close-ups are crops of the one product photo (origin x/y, scale). */
const shots = [
  { label: 'Front', zx: '50%', zy: '50%', zs: 1 },
  { label: 'Label', zx: '50%', zy: '44%', zs: 2.3 },
  { label: 'Ingredients', zx: '50%', zy: '54%', zs: 3 },
  { label: 'Pump', zx: '44%', zy: '14%', zs: 2.6 },
];

/** Related-finds option: the current product plus four others it can swap to in place. */
const finds = ['athena-body-wash', 'grace-glow-rouge-540', 'grace-glow-english-pear', 'hand-cream', 'sage-bottle']
  .map(byId)
  .map((x) => {
    const a = imageAttrs(x.image, { ratio: 1, widths: [240, 480, 800] })!;
    return {
      id: x.id,
      name: x.name,
      category: x.category,
      description: x.description,
      price: x.price ?? 0,
      src: a.src,
      srcset: a.srcset ?? '',
      alt: x.imageAlt ?? x.name,
    };
  });
const findsJson = JSON.stringify(finds).replace(/</g, '\\u003c');

const ico = {
  close:
    '<svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true"><path d="M1 1l12 12M13 1 1 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
  link: '<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M6.6 9.4a3 3 0 0 0 4.3 0l2.2-2.2a3 3 0 0 0-4.3-4.3l-.9.9M9.4 6.6a3 3 0 0 0-4.3 0L2.9 8.8a3 3 0 0 0 4.3 4.3l.9-.9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>',
  play: '<svg viewBox="0 0 8 10" width="8" height="10" aria-hidden="true"><path d="M0 0v10l8-5z" fill="currentColor"/></svg>',
  prev: '<svg viewBox="0 0 8 10" width="7" height="9" aria-hidden="true"><path d="M8 0v10L0 5z" fill="currentColor"/></svg>',
  shield:
    '<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M8 1.5 2.5 3.6v4c0 3.3 2.3 5.9 5.5 6.9 3.2-1 5.5-3.6 5.5-6.9v-4L8 1.5Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="m5.6 8 1.7 1.7 3.2-3.4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  up: '<svg viewBox="0 0 10 8" width="10" height="8" aria-hidden="true"><path d="M0 8h10L5 0z" fill="currentColor"/></svg>',
};

const options = [
  {
    n: 1,
    name: 'Refined drawer',
    note: 'Today’s drawer, tightened. The price and the TikTok button sit together in a pinned bar, so the next step is always one tap away. The duplicate name in the header is gone, and the affiliate note says what it means.',
    tags: ['Speed to TikTok', 'Price clarity'],
    phone: 'Bottom sheet',
    desk: 'Right drawer',
  },
  {
    n: 2,
    name: 'Split view',
    note: 'On desktop the photo takes half the popup and the details sit beside it, like a mini product page that never leaves the catalog. Adds size and key ingredients, plus a short “how buying works” answer.',
    tags: ['Desktop clarity', 'Trust'],
    phone: 'Tall sheet',
    desk: 'Split modal',
  },
  {
    n: 3,
    name: 'Immersive',
    note: 'The photo fills the screen and the details card slides up over it as you scroll, like a shopping app. On desktop the card floats over a full-bleed photo.',
    tags: ['Visual impact', 'App feel'],
    phone: 'Full screen',
    desk: 'Full-bleed modal',
  },
  {
    n: 4,
    name: 'Watch & shop',
    note: 'Your TikTok review sits right next to the product, so visitors can see it in use before they tap through. Two clear actions: watch the review, or view it on TikTok.',
    tags: ['Trust', 'Creator voice'],
    phone: 'Bottom sheet',
    desk: 'Video + details',
  },
  {
    n: 5,
    name: 'Gallery first',
    note: 'A big swipeable photo with a thumbnail rail and tap-to-zoom, for reading labels and ingredients up close. Close-ups here are crops of the one Athena photo.',
    tags: ['Detail', 'Confidence'],
    phone: 'Full screen',
    desk: 'Gallery modal',
  },
  {
    n: 6,
    name: 'Snap sheet',
    note: 'Opens as a short “peek” with just the name, price and TikTok button, all within thumb reach. Drag the handle up (or tap More details) for the full story; drag down to close.',
    tags: ['Thumb reach', 'Speed to TikTok'],
    phone: 'Peek sheet',
    desk: 'Peek sheet',
  },
  {
    n: 7,
    name: 'Editorial',
    note: 'Magazine style: a large italic serif name, a “Why it’s in my picks” pull quote and ingredient chips. Reads like a personal recommendation, not a listing. The quote is placeholder text.',
    tags: ['Personality', 'Trust'],
    phone: 'Tall sheet',
    desk: 'Magazine spread',
  },
  {
    n: 8,
    name: 'Related finds',
    note: 'Keeps people browsing: a “You might also like” row under the product. Tapping one swaps it in place, without closing the popup.',
    tags: ['Discovery', 'Time on site'],
    phone: 'Bottom sheet',
    desk: 'Centered modal',
  },
  {
    n: 9,
    name: 'Minimal peek',
    note: 'A small card with one photo, the price and the button. The fastest path to TikTok, for visitors who already know what they want.',
    tags: ['Speed to TikTok', 'Focus'],
    phone: 'Floating card',
    desk: 'Small card',
  },
  {
    n: 10,
    name: 'Dark luxe',
    note: 'Charcoal panel, white type and sage accents. A premium, after-dark take where the product photo glows like a gallery piece.',
    tags: ['Premium feel', 'Contrast'],
    phone: 'Dark sheet',
    desk: 'Dark card',
  },
];
---

<Base noindex title="Quick view options — bea">
  <script is:inline>
    // ?mock=<n> renders one option open over a faux catalog (used by the preview frames).
    if (/[?&]mock=\d+/.test(location.search)) document.documentElement.classList.add('is-mock');
  </script>

  <div class="qo">
    <header class="qo-head">
      <p class="eyebrow">Preview</p>
      <h1 class="display qo-title">Quick view — 10 options</h1>
      <p class="lede">
        Each one keeps the essentials: name, price in pesos with the “final price on TikTok” note, a clear View on
        TikTok button and the affiliate note. Tap <strong>Open preview</strong> to try it for real (on your phone too),
        then tell me the number you like.
      </p>
    </header>

    <nav class="qo-jump" aria-label="Jump to option">
      {options.map((o) => <a href={`#option-${o.n}`}>{o.n}</a>)}
    </nav>

    {
      options.map((o) => (
        <section class="qo-opt" id={`option-${o.n}`} aria-labelledby={`qo-name-${o.n}`}>
          <div class="qo-opt__meta">
            <h2 id={`qo-name-${o.n}`} class="qo-opt__name">
              <span class="qo-opt__num">{o.n}</span> {o.name}
            </h2>
            <p class="qo-opt__note">{o.note}</p>
            <ul class="qo-opt__tags" role="list" aria-label="Improves">
              {o.tags.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
            <button class="qo-open" type="button" data-open={o.n} aria-haspopup="dialog">
              Open preview
              <Fragment set:html={ico.play} />
            </button>
          </div>

          <div class="qo-stage" data-open={o.n} aria-hidden="true">
            <figure class="qo-dev qo-dev--phone">
              <div class="qo-dev__bezel">
                <div class="qo-dev__screen" data-w="390" style="--w:390;--h:844">
                  <iframe data-src={withBase(`/quickview-options/?mock=${o.n}`)} title="" tabindex="-1" inert />
                </div>
              </div>
              <figcaption>Phone · {o.phone}</figcaption>
            </figure>
            <figure class="qo-dev qo-dev--desk">
              <div class="qo-dev__bezel">
                <span class="qo-dev__bar">
                  <i />
                  <i />
                  <i />
                </span>
                <div class="qo-dev__screen" data-w="1440" style="--w:1440;--h:900">
                  <iframe data-src={withBase(`/quickview-options/?mock=${o.n}`)} title="" tabindex="-1" inert />
                </div>
              </div>
              <figcaption>Desktop · {o.desk}</figcaption>
            </figure>
          </div>
        </section>
      ))
    }
  </div>

  <!-- Faux catalog behind the popup in ?mock mode -->
  <div class="qo-mockbg" aria-hidden="true">
    <div class="qo-mockbg__bar">
      <span class="qo-mockbg__mark">bea<i></i></span>
      <span class="qo-mockbg__nav"><span>Finds</span><span>Videos</span><span>About</span></span>
    </div>
    <p class="display qo-mockbg__h">Top picks right now</p>
    <div class="qo-mockbg__grid">
      {
        finds.slice(0, 4).map((f) => (
          <div class="qo-mockbg__card">
            <div class="qo-mockbg__img">
              <img src={f.src} alt="" />
            </div>
            <p>{f.name}</p>
            <p class="qo-mockbg__price">{priceText(f.price)}</p>
          </div>
        ))
      }
    </div>
  </div>
  <div class="qo-scrim" aria-hidden="true"></div>

  <!-- ─────────────────────────── 1 · Refined drawer ─────────────────────────── -->
  <dialog class="qx qx--sheet v1" id="qx-1" aria-labelledby="v1-title">
    <span class="qx-grab v1__grab" aria-hidden="true"></span>
    <div class="v1__head">
      <p class="v1__crumbs"><span class="qx-chip">{p.category}</span><span>{p.badge}</span></p>
      <button class="qx-close" type="button" data-share aria-label="Copy link to this find">
        <Fragment set:html={ico.link} />
      </button>
      <button class="qx-close" type="button" data-close aria-label="Close quick view">
        <Fragment set:html={ico.close} />
      </button>
    </div>
    <div class="v1__body" data-reset-scroll>
      <div class="qx-panel v1__panel">
        <img src={img} alt={alt} loading="lazy" />
      </div>
      <h2 id="v1-title" class="display qx-title v1__title">{p.name}</h2>
      <p class="qx-desc v1__desc">{p.description}</p>
      <ul class="qx-tags v1__tags" role="list" aria-label="Key ingredients">
        {ingredients.map((i) => <li>{i}</li>)}
      </ul>
      <div class="v1__currency">
        <span>Show prices in</span>
        <CurrencySwitch />
      </div>
      <div class="qx-vids">
        <p class="qx-label">From my TikTok</p>
        <ul role="list">
          {
            clips.map((c) => (
              <li>
                <a class="qx-vid" href={VIDEO_LINK} target="_blank" rel="noopener">
                  <img src={c.thumb} alt="" loading="lazy" />
                  <span class="qx-vid__text">
                    <span>{c.caption}</span>
                    <span class="qx-vid__action">
                      Watch on TikTok<span class="visually-hidden"> (opens in a new tab)</span>
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div class="v1__foot">
      <div class="v1__price">
        <p class="qx-price"><span data-price-usd={usd}>{price}</span></p>
        <p class="qx-pnote">Final price on TikTok</p>
      </div>
      <div class="qx-cta"><Pill href={TEST_LINK} kind="affiliate" label="View on TikTok" block srContext={p.name} /></div>
      <p class="qx-aff v1__aff">Affiliate link · I may earn a small commission, at no extra cost to you</p>
    </div>
  </dialog>

  <!-- ─────────────────────────── 2 · Split view ─────────────────────────── -->
  <dialog class="qx qx--sheet v2" id="qx-2" aria-labelledby="v2-title">
    <button class="qx-close qx-close--float v2__x" type="button" data-close aria-label="Close quick view">
      <Fragment set:html={ico.close} />
    </button>
    <div class="v2__main" data-reset-scroll>
      <div class="v2__media">
        <img src={img} alt={alt} loading="lazy" />
        <span class="qx-badge">{p.badge}</span>
      </div>
      <div class="v2__info" data-reset-scroll>
        <p class="qx-chip">{p.category}</p>
        <h2 id="v2-title" class="display qx-title v2__title">{p.name}</h2>
        <div class="v2__price-row">
          <div>
            <p class="qx-price v2__price"><span data-price-usd={usd}>{price}</span></p>
            <p class="qx-pnote">{NOTE}</p>
          </div>
          <CurrencySwitch />
        </div>
        <p class="qx-desc">{p.description}</p>
        <dl class="v2__facts">
          <div><dt>Size</dt><dd>{size}</dd></div>
          <div><dt>Key ingredients</dt><dd>{ingredients.join(', ')}</dd></div>
          <div><dt>Category</dt><dd>{p.category}</dd></div>
        </dl>
        <details class="v2__how">
          <summary>How buying works</summary>
          <p>
            View on TikTok opens this find in TikTok Shop. Checkout, shipping and returns are all handled there — this
            site never takes payment.
          </p>
        </details>
        <div class="qx-vids">
          <p class="qx-label">From my TikTok</p>
          <ul role="list">
            {
              clips.map((c) => (
                <li>
                  <a class="qx-vid" href={VIDEO_LINK} target="_blank" rel="noopener">
                    <img src={c.thumb} alt="" loading="lazy" />
                    <span class="qx-vid__text">
                      <span>{c.caption}</span>
                      <span class="qx-vid__action">
                        Watch on TikTok<span class="visually-hidden"> (opens in a new tab)</span>
                      </span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <div class="v2__foot">
        <div class="qx-cta"><Pill href={TEST_LINK} kind="affiliate" label="View on TikTok" block srContext={p.name} /></div>
        <p class="qx-aff"><Fragment set:html={ico.shield} />Affiliate link · checkout happens on TikTok Shop</p>
      </div>
    </div>
  </dialog>

  <!-- ─────────────────────────── 3 · Immersive ─────────────────────────── -->
  <dialog class="qx v3" id="qx-3" aria-labelledby="v3-title">
    <div class="v3__bar">
      <button class="qx-close qx-close--float v3__x" type="button" data-close aria-label="Close quick view">
        <Fragment set:html={ico.close} />
      </button>
      <button class="qx-close qx-close--float" type="button" data-share aria-label="Copy link to this find">
        <Fragment set:html={ico.link} />
      </button>
    </div>
    <div class="v3__scroll" data-reset-scroll>
      <div class="v3__hero">
        <img class="v3__blur" src={img} alt="" loading="lazy" />
        <img class="v3__photo" src={img} alt={alt} loading="lazy" />
      </div>
      <div class="v3__card" data-reset-scroll>
        <span class="qx-grab" aria-hidden="true"></span>
        <p class="v3__chips"><span class="qx-chip">{p.category}</span><span class="v3__pick">{p.badge}</span></p>
        <h2 id="v3-title" class="display qx-title v3__title">{p.name}</h2>
        <p class="qx-price v3__price"><span data-price-usd={usd}>{price}</span></p>
        <p class="qx-pnote">{NOTE}</p>
        <p class="qx-desc v3__desc">{p.description}</p>
        <ul class="qx-tags" role="list" aria-label="Key ingredients">
          {ingredients.map((i) => <li>{i}</li>)}
        </ul>
        <div class="qx-vids">
          <p class="qx-label">From my TikTok</p>
          <ul role="list">
            {
              clips.map((c) => (
                <li>
                  <a class="qx-vid" href={VIDEO_LINK} target="_blank" rel="noopener">
                    <img src={c.thumb} alt="" loading="lazy" />
                    <span class="qx-vid__text">
                      <span>{c.caption}</span>
                      <span class="qx-vid__action">
                        Watch on TikTok<span class="visually-hidden"> (opens in a new tab)</span>
                      </span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
    <div class="v3__foot">
      <div class="qx-cta"><Pill href={TEST_LINK} kind="affiliate" label="View on TikTok" block srContext={p.name} /></div>
      <p class="qx-aff">Affiliate link</p>
    </div>
  </dialog>

  <!-- ─────────────────────────── 4 · Watch & shop ─────────────────────────── -->
  <dialog class="qx qx--sheet v4" id="qx-4" aria-labelledby="v4-title">
    <span class="qx-grab" aria-hidden="true"></span>
    <button class="qx-close v4__x" type="button" data-close aria-label="Close quick view">
      <Fragment set:html={ico.close} />
    </button>
    <div class="v4__body" data-reset-scroll>
      <a class="v4__video" href={VIDEO_LINK} target="_blank" rel="noopener">
        <img src={img} alt="" loading="lazy" />
        <span class="v4__play"><Fragment set:html={ico.play} /></span>
        <span class="v4__dur" aria-hidden="true">0:42</span>
        <span class="v4__cap">
          <b>@{site.tiktokHandle}</b>
          <span class="v4__capline">The body wash I keep repurchasing</span>
        </span>
        <span class="visually-hidden">Watch my review on TikTok (opens in a new tab)</span>
      </a>
      <div class="v4__top">
        <p class="v4__eyebrow"><i aria-hidden="true"></i>Seen on my TikTok</p>
        <h2 id="v4-title" class="display qx-title v4__title">{p.name}</h2>
        <div>
          <p class="qx-price"><span data-price-usd={usd}>{price}</span></p>
          <p class="qx-pnote">{NOTE}</p>
        </div>
      </div>
      <div class="v4__desc">
        <p class="qx-desc">{p.description}</p>
        <ul class="qx-tags" role="list" aria-label="Key ingredients">
          {ingredients.map((i) => <li>{i}</li>)}
        </ul>
        <div class="qx-vids v4__vids">
          <p class="qx-label">More from my TikTok</p>
          <ul role="list">
            {
              clips.map((c) => (
                <li>
                  <a class="qx-vid" href={VIDEO_LINK} target="_blank" rel="noopener">
                    <img src={c.thumb} alt="" loading="lazy" />
                    <span class="qx-vid__text">
                      <span>{c.caption}</span>
                      <span class="qx-vid__action">
                        Watch on TikTok<span class="visually-hidden"> (opens in a new tab)</span>
                      </span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <div class="v4__act">
        <div class="qx-cta v4__ctas">
          <Pill href={VIDEO_LINK} kind="external" variant="secondary" label="Watch my review" block />
          <Pill href={TEST_LINK} kind="affiliate" label="View on TikTok" block srContext={p.name} />
        </div>
        <p class="qx-aff">Affiliate link</p>
      </div>
    </div>
  </dialog>

  <!-- ─────────────────────────── 5 · Gallery first ─────────────────────────── -->
  <dialog class="qx v5" id="qx-5" aria-labelledby="v5-title">
    <button class="qx-close qx-close--float v5__x" type="button" data-close aria-label="Close quick view">
      <Fragment set:html={ico.close} />
    </button>
    <div class="v5__scroll" data-reset-scroll>
      <div class="v5__stage">
        <div class="v5__viewer" data-v5-viewer tabindex="0" aria-label="Product photos, use arrow keys to browse" role="group">
          {
            shots.map((s, i) => (
              <figure class="v5__slide">
                <button
                  class="v5__zoom"
                  type="button"
                  aria-pressed="false"
                  aria-label={`Zoom in: ${s.label.toLowerCase()} (${i + 1} of ${shots.length})`}
                  data-v5-zoom
                >
                  <span class="v5__zoomer">
                    <span class="v5__crop" style={`--zx:${s.zx};--zy:${s.zy};--zs:${s.zs}`}>
                      <img src={img} alt={i === 0 ? alt : ''} loading="lazy" draggable="false" />
                    </span>
                  </span>
                </button>
              </figure>
            ))
          }
        </div>
        <button class="v5__nav v5__nav--prev" type="button" data-v5-step="-1" aria-label="Previous photo">
          <Fragment set:html={ico.prev} />
        </button>
        <button class="v5__nav v5__nav--next" type="button" data-v5-step="1" aria-label="Next photo">
          <Fragment set:html={ico.play} />
        </button>
        <span class="v5__count" data-v5-count aria-live="polite">1 / {shots.length}</span>
        <span class="v5__hint" data-v5-hint aria-hidden="true">Tap to zoom</span>
      </div>
      <div class="v5__rail" role="group" aria-label="Choose a photo">
        {
          shots.map((s, i) => (
            <button class="v5__thumb" type="button" data-v5-go={i} aria-label={`Show ${s.label.toLowerCase()}`} aria-current={i === 0 ? 'true' : 'false'}>
              <span class="v5__crop" style={`--zx:${s.zx};--zy:${s.zy};--zs:${s.zs}`}>
