    const SMILE = [3, 2, 28, 22, 72, 22, 97, 2];
    const toD = (p: number[]) => `M${p[0]} ${p[1]}C${p[2]} ${p[3]} ${p[4]} ${p[5]} ${p[6]} ${p[7]}`;
    // Damped spring overshoot, 0 → 1.
    const spring = (t: number) => 1 - Math.exp(-6 * t) * Math.cos(9 * t);
    document.querySelectorAll<HTMLElement>('[data-smile]').forEach((logo) => {
      const path = logo.querySelector<SVGPathElement>('.l5__smile path')!;
      let from = 0;
      let current = 0;
      let target = 0;
      let start = 0;
      let raf = 0;
      const render = (k: number) => path.setAttribute('d', toD(FLAT.map((v, i) => v + (SMILE[i] - v) * k)));
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / (target ? 900 : 520));
        const e = target ? spring(t * 1.15) : 1 - Math.pow(1 - t, 3);
        current = from + (target - from) * e;
        render(current);
        raf = t < 1 ? requestAnimationFrame(tick) : 0;
      };
      const go = (to: number) => {
        target = to;
        if (reduce) {
          current = to;
          render(to);
          return;
        }
        from = current;
        start = performance.now();
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(tick);
      };
      logo.addEventListener('pointerenter', () => go(1));
      logo.addEventListener('pointerleave', () => document.activeElement !== logo && go(0));
      logo.addEventListener('focus', () => logo.matches(':focus-visible') && go(1));
      logo.addEventListener('blur', () => !logo.matches(':hover') && go(0));
    });

    // 9 · Extruded: the extrusion falls away from the cursor, like a light source.
    document.querySelectorAll<HTMLElement>('[data-extrude]').forEach((logo) => {
      const word = logo.querySelector<HTMLElement>('.l9__w')!;
      const area = logo.closest<HTMLElement>('.nav, .stage') || logo;
      const reset = () => {
        word.style.removeProperty('--dx');
        word.style.removeProperty('--dy');
      };
      area.addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse') return;
        const r = word.getBoundingClientRect();
        const vx = r.left + r.width / 2 - e.clientX;
        const vy = r.top + r.height / 2 - e.clientY;
        const len = Math.hypot(vx, vy) || 1;
        word.style.setProperty('--dx', (vx / len).toFixed(3));
        word.style.setProperty('--dy', (vy / len).toFixed(3));
      });
      area.addEventListener('pointerleave', reset);
    });
  </script>
</Base>
