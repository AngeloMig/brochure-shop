---
/**
 * Preview page: five footer wordmark treatments to choose from.
 * Visit /footer-options. Not linked from the site and hidden from search.
 * Once one is chosen it moves into Footer.astro and this page can be deleted.
 */
import '@fontsource/instrument-serif/latin-400-italic.css';
import Base from '../layouts/Base.astro';
import { site } from '../config/site';

const word = site.brandName;
const chars = [...word];
const options = [
  { n: 1, name: 'Rise & draw', note: 'Letters rise out of a mask one by one, a swash draws underneath and the dot drops in with a bounce. Plays when the footer scrolls into view.' },
  { n: 2, name: 'Outline fill', note: 'The wordmark starts as a fine outline and fills with white as you scroll down to it. Tied to scroll, so it feels hand-controlled.' },
  { n: 3, name: 'Slow marquee', note: 'An endless, slow ribbon of the wordmark, alternating solid and outline. Hover (or press) to pause.' },
  { n: 4, name: 'Spotlight', note: 'The wordmark rests in soft charcoal; a sage-lit spotlight follows your cursor and reveals it in white. On phones the light drifts on its own.' },
  { n: 5, name: 'Rolling dot', note: 'The sage dot rolls in along the baseline and each letter hops as it passes, before the dot settles into place.' },
];
---

<Base noindex title="Footer wordmark options — bea">
  <div class="lab">
    <header class="lab__head">
      <p class="eyebrow">Preview</p>
      <h1 class="display lab__title">Footer wordmark — 5 options</h1>
      <p class="lede">Scroll through each one. Options 1 and 5 replay with the button. Tell me the number you like and it goes into the footer.</p>
    </header>

    {
      options.map((o) => (
        <section class="opt" aria-labelledby={`opt-${o.n}`}>
          <div class="opt__meta">
            <h2 id={`opt-${o.n}`} class="opt__name">
              <span class="opt__num">{o.n}</span> {o.name}
            </h2>
            <p class="opt__note">{o.note}</p>
            {(o.n === 1 || o.n === 5) && (
              <button class="opt__replay" type="button" data-replay={o.n}>
                Replay
              </button>
            )}
          </div>

          <div class={`panel panel--${o.n}`} data-panel={o.n}>
            {o.n === 1 && (
              <div class="mark rise" aria-label={word}>
                {chars.map((c, i) => (
                  <span class="rise__mask" aria-hidden="true">
                    <span class="rise__char" style={`--i:${i}`}>
                      {c}
                    </span>
                  </span>
                ))}
                <span class="dot rise__dot" aria-hidden="true" />
                <svg class="rise__swash" viewBox="0 0 100 12" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M2 8.5C22 3 46 2.5 64 5.5S90 10 98 4" pathLength="1" />
                </svg>
              </div>
            )}

            {o.n === 2 && (
              <div class="mark fill" aria-label={word}>
                <span class="fill__outline" aria-hidden="true">
                  {word}
                  <span class="dot dot--outline" />
                </span>
                <span class="fill__solid" aria-hidden="true">
                  {word}
                  <span class="dot" />
                </span>
              </div>
            )}

            {o.n === 3 && (
              <div class="marquee" aria-label={word}>
                <div class="marquee__track" aria-hidden="true">
                  {Array.from({ length: 2 }).map(() => (
                    <div class="marquee__group">
                      {Array.from({ length: 4 }).map((_, i) => (
                        <span class:list={['marquee__item', i % 2 === 1 && 'is-outline']}>
                          {word}
                          <span class:list={['dot', i % 2 === 1 && 'dot--outline']} />
                        </span>
                      ))}
                    </div>
                  ))}
                </div>
              </div>
            )}

            {o.n === 4 && (
              <div class="mark spot" aria-label={word} data-spot>
                <span class="spot__base" aria-hidden="true">
                  {word}
                  <span class="dot" />
                </span>
                <span class="spot__lit" aria-hidden="true">
                  {word}
                  <span class="dot" />
                </span>
              </div>
            )}

            {o.n === 5 && (
              <div class="mark roll" aria-label={word}>
                {chars.map((c, i) => (
                  <span class="roll5__char" style={`--i:${i}`} aria-hidden="true">
                    {c}
                  </span>
                ))}
                <span class="dot roll5__dot" aria-hidden="true" />
              </div>
            )}
          </div>
        </section>
      ))
    }
  </div>

  <style>
    .lab {
      max-width: var(--page-max);
      margin: 0 auto;
      padding: 48px var(--gutter) 96px;
    }
    .lab__head {
      display: grid;
      gap: 14px;
      margin-bottom: 48px;
    }
    .lab__title {
      font-size: var(--h2);
    }
    .opt {
      display: grid;
      gap: 20px;
      margin-bottom: 64px;
    }
    .opt__meta {
      display: grid;
      gap: 8px;
      justify-items: start;
      max-width: 62ch;
    }
    .opt__name {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: var(--text-lg);
      font-weight: 600;
    }
    .opt__num {
      display: grid;
      place-items: center;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: var(--color-ink);
      color: var(--color-on-dark);
      font-size: var(--text-sm);
    }
    .opt__note {
      color: var(--color-muted);
      line-height: 1.55;
    }
    .opt__replay {
      min-height: 40px;
      padding: 0 18px;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-pill);
      font-size: var(--text-sm);
      font-weight: 500;
    }
    .opt__replay:hover {
      border-color: var(--color-ink);
    }

    /* Shared panel + wordmark */
    .panel {
      --size: clamp(6rem, 2rem + 24vw, 22rem);
      position: relative;
      display: grid;
      place-items: center;
      min-height: calc(var(--size) * 1.35);
      padding: 24px;
      border-radius: var(--radius-block);
      background: var(--color-ink);
      color: var(--color-on-dark);
      overflow: hidden;
    }
    .mark,
    .marquee__item {
      position: relative;
      display: inline-flex;
      align-items: baseline;
      font-family: 'Instrument Serif', 'Times New Roman', serif;
      font-style: italic;
      font-size: var(--size);
      letter-spacing: -0.035em;
      line-height: 0.9;
      white-space: nowrap;
    }
    .dot {
      display: inline-block;
      width: 0.16em;
      height: 0.16em;
      margin-left: 0.04em;
      border-radius: 50%;
      background: var(--color-sage);
    }
    .dot--outline {
      background: transparent;
      box-shadow: inset 0 0 0 0.012em var(--color-sage);
    }

    /* 1 — Rise & draw */
    .rise__mask {
      display: inline-block;
      overflow: hidden;
      padding: 0.08em 0.03em 0.12em;
      margin: -0.08em -0.03em -0.12em;
    }
    .rise__char {
      display: inline-block;
      transform: translateY(110%);
    }
    .rise__dot {
      transform: translateY(-1.4em);
      opacity: 0;
    }
    .rise__swash {
      position: absolute;
      left: 4%;
      bottom: -0.1em;
      width: 86%;
      height: 0.16em;
      overflow: visible;
    }
    .rise__swash path {
      fill: none;
      stroke: var(--color-sage);
      stroke-width: 0.9;
      stroke-linecap: round;
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }
    .is-playing .rise__char {
      animation: rise 900ms cubic-bezier(0.22, 1, 0.36, 1) calc(var(--i) * 110ms) both;
    }
    .is-playing .rise__dot {
      animation: drop 900ms cubic-bezier(0.34, 1.56, 0.64, 1) 520ms both;
    }
    .is-playing .rise__swash path {
      animation: draw 900ms cubic-bezier(0.22, 1, 0.36, 1) 760ms both;
    }
    @keyframes rise {
      from {
        transform: translateY(110%);
      }
      to {
        transform: none;
      }
    }
    @keyframes drop {
      0% {
        transform: translateY(-1.4em);
        opacity: 0;
      }
      30% {
        opacity: 1;
      }
      100% {
        transform: none;
        opacity: 1;
      }
    }
    @keyframes draw {
      to {
        stroke-dashoffset: 0;
      }
    }

    /* 2 — Outline fill (scroll-linked) */
    .fill {
      --fill: 0;
    }
    .fill__outline,
    .fill__solid {
      display: inline-flex;
      align-items: baseline;
    }
    .fill__outline {
      color: transparent;
      -webkit-text-stroke: 1.5px rgb(255 255 255 / 0.55);
    }
    .fill__solid {
      position: absolute;
      inset: 0;
      color: var(--color-on-dark);
      clip-path: inset(0 calc((1 - var(--fill)) * 100%) 0 0);
    }

    /* 3 — Slow marquee */
    .panel--3 {
      place-items: center start;
      padding-inline: 0;
    }
    .marquee {
      width: 100%;
      overflow: hidden;
      mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    }
    .marquee__track {
      display: flex;
      width: max-content;
      animation: marquee 48s linear infinite;
    }
    .marquee:hover .marquee__track,
    .marquee:active .marquee__track {
      animation-play-state: paused;
    }
    .marquee__group {
      display: flex;
      gap: 0.35em;
      padding-right: 0.35em;
    }
    .marquee__item.is-outline {
      color: transparent;
      -webkit-text-stroke: 1.5px rgb(255 255 255 / 0.6);
    }
    @keyframes marquee {
      to {
        transform: translateX(-50%);
      }
    }

    /* 4 — Spotlight */
    .spot {
      --mx: 50%;
      --my: 50%;
    }
    .spot__base,
    .spot__lit {
      display: inline-flex;
      align-items: baseline;
    }
    .spot__base {
      color: #45473f;
    }
    .spot__base .dot {
      background: #5d6152;
    }
    .spot__lit {
      position: absolute;
      inset: 0;
      color: var(--color-on-dark);
      -webkit-mask-image: radial-gradient(circle 0.9em at var(--mx) var(--my), #000 35%, transparent 75%);
      mask-image: radial-gradient(circle 0.9em at var(--mx) var(--my), #000 35%, transparent 75%);
    }
    .panel--4::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(circle 280px at var(--px, 50%) var(--py, 50%), rgb(168 173 152 / 0.18), transparent 70%);
      pointer-events: none;
    }

    /* 5 — Rolling dot */
    .roll5__char {
      display: inline-block;
    }
    .roll5__dot {
      position: relative;
    }
    .is-playing .roll5__dot {
      animation: roll 1700ms cubic-bezier(0.45, 0, 0.25, 1) both;
    }
    .is-playing .roll5__char {
      animation: bump 520ms cubic-bezier(0.34, 1.56, 0.64, 1) calc(240ms + var(--i) * 300ms) both;
    }
    @keyframes roll {
      0% {
        transform: translateX(-2.6em) rotate(-720deg);
        opacity: 0;
      }
      12% {
        opacity: 1;
      }
      82% {
        transform: translateX(0.06em) rotate(0deg);
      }
      90% {
        transform: translateX(-0.02em) translateY(-0.14em);
      }
      100% {
        transform: none;
      }
    }
    @keyframes bump {
      0%,
      100% {
        transform: none;
      }
      45% {
        transform: translateY(-0.12em) rotate(-4deg);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .rise__char,
      .rise__dot {
        transform: none !important;
        opacity: 1 !important;
        animation: none !important;
      }
      .rise__swash path {
        stroke-dashoffset: 0;
        animation: none !important;
      }
      .marquee__track,
      .roll5__dot,
      .roll5__char {
        animation: none !important;
      }
      .fill__solid {
        clip-path: none;
      }
    }
  </style>

  <script>
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 1 & 5: play when the panel scrolls into view; Replay restarts.
    const play = (panel: Element) => {
      panel.classList.remove('is-playing');
      void (panel as HTMLElement).offsetWidth;
      panel.classList.add('is-playing');
    };
    const once = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting) {
            play(e.target);
            once.unobserve(e.target);
          }
        }),
      { threshold: 0.5 },
    );
    document.querySelectorAll('[data-panel="1"], [data-panel="5"]').forEach((p) => once.observe(p));
    document.querySelectorAll<HTMLButtonElement>('[data-replay]').forEach((b) =>
      b.addEventListener('click', () => play(document.querySelector(`[data-panel="${b.dataset.replay}"]`)!)),
    );

    // 2: fill follows scroll position through the viewport.
    const fillPanel = document.querySelector<HTMLElement>('[data-panel="2"]');
    const fill = fillPanel?.querySelector<HTMLElement>('.fill');
    let raf = 0;
    const onScroll = () => {
      raf = 0;
      if (!fillPanel || !fill) return;
      const r = fillPanel.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight - r.top) / (innerHeight * 0.75 + r.height * 0.25)));
      fill.style.setProperty('--fill', reduce ? '1' : p.toFixed(3));
    };
    addEventListener('scroll', () => (raf ||= requestAnimationFrame(onScroll)), { passive: true });
    onScroll();

    // 4: spotlight follows the pointer; drifts on its own for touch screens.
    const spotPanel = document.querySelector<HTMLElement>('[data-panel="4"]');
    const spot = spotPanel?.querySelector<HTMLElement>('[data-spot]');
    if (spotPanel && spot) {
      let pointer = false;
      spotPanel.addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse') return;
        pointer = true;
        const s = spot.getBoundingClientRect();
        const p = spotPanel.getBoundingClientRect();
        spot.style.setProperty('--mx', `${e.clientX - s.left}px`);
        spot.style.setProperty('--my', `${e.clientY - s.top}px`);
        spotPanel.style.setProperty('--px', `${e.clientX - p.left}px`);
        spotPanel.style.setProperty('--py', `${e.clientY - p.top}px`);
      });
      spotPanel.addEventListener('pointerleave', () => (pointer = false));
      if (!reduce) {
        const t0 = performance.now();
        const drift = (now: number) => {
          if (!pointer) {
            const t = (now - t0) / 1000;
            const s = spot.getBoundingClientRect();
            const p = spotPanel.getBoundingClientRect();
            const x = s.width * (0.5 + Math.sin(t * 0.6) * 0.42);
            const y = s.height * (0.5 + Math.sin(t * 1.1) * 0.2);
            spot.style.setProperty('--mx', `${x}px`);
            spot.style.setProperty('--my', `${y}px`);
            spotPanel.style.setProperty('--px', `${x + s.left - p.left}px`);
            spotPanel.style.setProperty('--py', `${y + s.top - p.top}px`);
          }
          requestAnimationFrame(drift);
        };
        requestAnimationFrame(drift);
      } else {
        spot.style.setProperty('--mx', '50%');
      }
    }
  </script>
</Base>
