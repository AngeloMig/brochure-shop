---
/**
 * Editorial feature: a tall lifestyle photo with the heading on it, beside one
 * highlighted product. Configure in src/config/site.ts → spotlight.
 */
import { site } from '../config/site';
import { getProduct } from '../lib/catalog';
import Media from './Media.astro';
import Pill from './Pill.astro';
import Price from './Price.astro';

const { spotlight } = site;
const product = getProduct(spotlight.productId);
---

{
  product && (
    <section class="section spotlight" aria-labelledby="spotlight-title">
      <div class="container spotlight__grid">
        <div class="spotlight__feature" data-reveal>
          <Media
            src={spotlight.image}
            alt={spotlight.imageAlt}
            ratio={4 / 5}
            sizes="(min-width: 900px) 58vw, 100vw"
            position={spotlight.imagePosition}
            class="spotlight__photo"
          />
          <div class="spotlight__overlay">
            <p class="eyebrow">{spotlight.eyebrow}</p>
            <h2 id="spotlight-title" class="display h2">
              {spotlight.heading}
            </h2>
          </div>
        </div>

        <div class="spotlight__product" data-id={product.id} data-reveal>
          <button
            class="spotlight__panel"
            type="button"
            data-quickview={product.id}
            aria-haspopup="dialog"
            aria-label={`Quick view: ${product.name}`}
          >
            <Media
              src={product.image}
              alt=""
              ratio={1}
              sizes="(min-width: 900px) 38vw, 100vw"
              fallbackSrc={product.imageFallback}
              class="spotlight__img"
              fallbackLabel={product.name}
            />
            {product.badge && <span class="spotlight__badge">{product.badge}</span>}
          </button>
          <div class="spotlight__info">
            <p class="spotlight__cat">{product.category}</p>
            <h3 class="display h3">{product.name}</h3>
            <p class="spotlight__price"><Price usd={product.price} /></p>
            <p class="lede">{spotlight.text}</p>
            <div class="spotlight__actions">
              <Pill href={product.affiliateUrl} kind="affiliate" label="View on TikTok" srContext={product.name} />
              <button class="text-link" type="button" data-quickview={product.id} aria-haspopup="dialog">
                Quick view
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .spotlight__grid {
    display: grid;
    gap: var(--gap-cards);
  }
  .spotlight__feature {
    position: relative;
    border-radius: var(--radius-block);
    overflow: hidden;
    color: var(--color-on-dark);
  }
  .spotlight__feature :global(.spotlight__photo) {
    max-height: 78svh;
    width: 100%;
  }
  .spotlight__overlay {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    gap: 10px;
    padding: 96px 24px 28px;
    background: linear-gradient(to top, rgb(20 21 18 / 0.55), rgb(20 21 18 / 0));
  }
  .spotlight__overlay h2 {
    max-width: 12ch;
  }

  .spotlight__product {
    display: grid;
    gap: 28px;
    align-content: start;
  }
  .spotlight__panel {
    position: relative;
    display: block;
    width: 100%;
    border-radius: var(--radius-panel);
    overflow: hidden;
    background: var(--color-panel);
  }
  .spotlight__panel :global(img) {
    mix-blend-mode: multiply;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .spotlight__panel:hover :global(img) {
    transform: scale(1.03);
  }
  .spotlight__badge {
    position: absolute;
    top: 16px;
    left: 16px;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    font-size: var(--text-xs);
    font-weight: 500;
  }
  .spotlight__info {
    display: grid;
    gap: 12px;
    padding-inline: 4px;
  }
  .spotlight__price {
    font-size: var(--text-lg);
    font-weight: 500;
  }
  .spotlight__cat {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .spotlight__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    margin-top: 12px;
  }

  @media (min-width: 900px) {
    .spotlight__grid {
      grid-template-columns: 1.45fr 1fr;
      gap: var(--gap-cards);
      align-items: stretch;
    }
    .spotlight__feature {
      position: sticky;
      top: calc(var(--header-h) + 16px);
      align-self: start;
    }
    .spotlight__feature :global(.spotlight__photo) {
      aspect-ratio: auto !important;
      height: min(calc(100svh - var(--header-h) - 32px), 860px);
      max-height: none;
    }
    .spotlight__overlay {
      padding: 140px 40px 40px;
    }
    .spotlight__product {
      align-content: space-between;
      gap: 40px;
    }
    .spotlight__info {
      padding: 0 8px 8px;
    }
  }
</style>
