---
/**
 * Header. At the top it sits inside the hero frame; once the page scrolls it
 * morphs into a floating frosted oval (narrower, shorter, fully rounded) so
 * the links stay readable over any section.
 */
import { site } from '../config/site';
import { isUsableUrl, external, contactRows } from '../lib/links';
import Wordmark from './Wordmark.astro';

const hasProfile = isUsableUrl(site.tiktokProfileUrl);
const contacts = contactRows(site.contact).filter((c) => c.href);
---

<header class="site-header" data-header>
  <div class="site-header__bar">
    <nav class="site-header__nav" aria-label="Main">
      <ul role="list">
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href}>
                <span class="roll">
                  <span class="roll__text" data-text={item.label}>
                    {item.label}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__brand">
      <Wordmark />
    </div>

    <div class="site-header__end">
      {
        hasProfile ? (
          <a class="follow" href={site.tiktokProfileUrl} {...external}>
            <span class="roll">
              <span class="roll__text" data-text="Follow on TikTok">
                Follow on TikTok
              </span>
            </span>
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        ) : (
          <span class="follow follow--soon" title="Add your profile URL in src/config/site.ts">
            <span>@{site.tiktokHandle}</span>
          </span>
        )
      }
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="menu-toggle__text" aria-hidden="true">
          <span class="menu-toggle__word">Menu</span>
          <span class="menu-toggle__word">Close</span>
        </span>
        <span class="menu-toggle__icon" aria-hidden="true"><span></span><span></span></span>
        <span class="visually-hidden" data-menu-label>Open menu</span>
      </button>
    </div>
  </div>

  <div class="menu-scrim" hidden data-menu-scrim></div>
  <div class="mobile-menu" id="mobile-menu" hidden data-menu>
    <nav aria-label="Mobile">
      <ul role="list">
        {
          site.nav.map((item, i) => (
            <li style={`--i:${i}`}>
              <a class="display" href={item.href} data-menu-link>
                {item.label}
                <svg viewBox="0 0 8 10" width="9" height="11" aria-hidden="true">
                  <path d="M0 0v10l8-5z" fill="currentColor" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    {
      hasProfile ? (
        <a class="mobile-menu__follow" href={site.tiktokProfileUrl} {...external}>
          <span>Follow @{site.tiktokHandle}<span class="mobile-menu__follow-tail"> on TikTok</span></span>
          <span class="visually-hidden"> (opens in a new tab)</span>
        </a>
      ) : (
        <p class="mobile-menu__follow mobile-menu__follow--soon">
          TikTok profile link coming soon
        </p>
      )
    }
    {
      contacts.length > 0 && (
        <div class="mobile-menu__contact">
          <span class="mobile-menu__contact-label">For business</span>
          <ul role="list">
            {contacts.map((c) => (
              <li>
                <a href={c.href!} {...(c.newTab ? external : {})}>
                  {c.label}
                  <span class="visually-hidden">
                    {' '}
                    — {c.value}
                    {c.newTab ? ' (opens in a new tab)' : ''}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</header>

<style>
  .site-header {
    --bar-max: calc(var(--page-max) - 40px);
    --morph: 520ms var(--ease-out);
    position: sticky;
    top: 0;
    z-index: 40;
    display: flow-root; /* keeps the oval's top margin from collapsing */
    height: var(--header-h);
    padding-inline: var(--gutter);
    pointer-events: none; /* only the bar itself catches clicks */
  }
  @media (min-width: 1200px) {
    .site-header {
      padding-inline: calc(var(--gutter) + 20px);
    }
  }

  .site-header__bar {
    --rest-inset: 12px;
    pointer-events: auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--header-h);
    max-width: var(--bar-max);
    margin: 0 auto;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 999px;
    background: rgb(255 255 255 / 0);
    transition:
      max-width var(--morph),
      height var(--morph),
      margin var(--morph),
      padding var(--morph),
      background-color var(--morph),
      border-color var(--morph),
      box-shadow var(--morph),
      backdrop-filter var(--morph);
  }

  /* At rest the bar sits inside the hero frame, so inset it from the frame edges */
  .site-header:not([data-scrolled]):not([data-open]) .site-header__bar {
    padding-inline: var(--rest-inset);
  }
  @media (min-width: 1200px) {
    .site-header__bar {
      --rest-inset: 0px; /* wide screens already add the inset on the header */
    }
  }

  /* Scrolled (or menu open): the frosted oval */
  .site-header:is([data-scrolled], [data-open]) .site-header__bar {
    --pill-h: 52px;
    height: var(--pill-h);
    margin-top: 20px;
    padding: 0 6px 0 20px;
    background: rgb(255 255 255 / 0.86);
    border-color: rgb(41 43 39 / 0.08);
    box-shadow:
      0 1px 2px rgb(41 43 39 / 0.04),
      0 10px 30px -12px rgb(41 43 39 / 0.18);
    backdrop-filter: blur(18px) saturate(1.4);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
  }
  @media (min-width: 960px) {
    .site-header:is([data-scrolled], [data-open]) .site-header__bar {
      --pill-h: 56px;
      max-width: 940px;
      padding: 0 8px 0 26px;
    }
  }
  @supports not (backdrop-filter: blur(1px)) {
    .site-header:is([data-scrolled], [data-open]) .site-header__bar {
      background: rgb(255 255 255 / 0.97);
    }
  }

  .site-header__brand {
    grid-column: 2;
    display: flex;
    justify-content: center;
  }
  .site-header__nav {
    grid-column: 1;
    grid-row: 1;
  }
  .site-header__end {
    grid-column: 3;
    grid-row: 1;
  }
  .site-header[data-scrolled] :global(.wordmark__word) {
    --fs: 1.875rem;
  }

  .site-header__nav ul {
    display: none;
    gap: 30px;
  }
  .site-header__nav a,
  .follow {
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
  }
  .site-header__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .site-header__end {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
  }
  .follow {
    display: none;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    transition:
      border-color var(--dur) var(--ease-out),
      background-color var(--morph);
  }
  .site-header[data-scrolled] .follow {
    background: var(--color-panel);
    border-color: transparent;
  }
  a.follow:hover {
    border-color: var(--color-ink);
  }
  .follow--soon {
    color: var(--color-muted);
  }

  /* Hamburger: an ink pill with a rolling Menu/Close label and two lines that morph into an × */
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 40px;
    padding: 0 14px 0 16px;
    border-radius: var(--radius-pill);
    background: var(--color-ink);
    color: var(--color-on-dark);
    font-size: 0.8125rem;
    font-weight: 500;
    transition: background-color var(--dur) var(--ease-out);
    /* keep a 44px tap area around the smaller pill */
    position: relative;
  }
  @media (hover: hover) {
    .menu-toggle:hover {
      background: #4a4c46;
    }
  }
  .menu-toggle:active {
    transform: scale(0.97);
  }
  .menu-toggle__text {
    display: grid;
    height: 1.4em;
    overflow: hidden;
    line-height: 1.4;
  }
  .menu-toggle__word {
    grid-area: 1 / 1;
    transition: transform 520ms cubic-bezier(0.625, 0.05, 0, 1);
  }
  .menu-toggle__word + .menu-toggle__word {
    transform: translateY(100%);
  }
  [aria-expanded='true'] .menu-toggle__word:first-child {
    transform: translateY(-100%);
  }
  [aria-expanded='true'] .menu-toggle__word + .menu-toggle__word {
    transform: none;
  }
  .site-header:is([data-scrolled], [data-open]) .menu-toggle {
    height: 36px;
    padding: 0 12px 0 14px;
    font-size: 0.75rem;
    gap: 8px;
  }
  .site-header:is([data-scrolled], [data-open]) .menu-toggle::after {
    inset: -4px; /* still a 44px tap area */
  }
  .menu-toggle {
    transition:
      background-color var(--dur) var(--ease-out),
      height 420ms var(--ease-out),
      padding 420ms var(--ease-out),
      font-size 420ms var(--ease-out);
  }
  .menu-toggle::after {
    content: '';
    position: absolute;
    inset: -2px;
  }
  .menu-toggle__icon {
    position: relative;
    width: 15px;
    height: 10px;
  }
  .menu-toggle__icon span {
    position: absolute;
    left: 0;
    right: 0;
    height: 1.5px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 420ms var(--ease-out),
      top 420ms var(--ease-out);
  }
  .menu-toggle__icon span:first-child {
    top: 1px;
  }
  .menu-toggle__icon span:last-child {
    top: 7.5px;
  }
  [aria-expanded='true'] .menu-toggle__icon span:first-child {
    top: 4.25px;
    transform: rotate(45deg);
  }
  [aria-expanded='true'] .menu-toggle__icon span:last-child {
    top: 4.25px;
    transform: rotate(-45deg);
  }

  /* Dim the page behind the open menu; tapping it closes the menu */
  .menu-scrim {
    pointer-events: auto;
    position: fixed;
    inset: 0;
    z-index: -1;
    background: rgb(28 29 26 / 0.32);
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
  }
  @media (prefers-reduced-motion: no-preference) {
    .menu-scrim:not([hidden]) {
      animation: scrim-in 320ms ease-out;
    }
  }
  @keyframes scrim-in {
    from {
      opacity: 0;
    }
  }
  :global(html.menu-open) {
    overflow: hidden;
  }

  .mobile-menu {
    pointer-events: auto;
    position: absolute;
    top: calc(20px + 52px + 8px);
    left: var(--gutter);
    right: var(--gutter);
    padding: 8px 8px 8px;
    border-radius: 28px;
    background: rgb(255 255 255 / 0.97);
    border: 1px solid rgb(41 43 39 / 0.08);
    box-shadow: 0 24px 48px -20px rgb(41 43 39 / 0.3);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }
  .mobile-menu nav ul {
    padding: 4px 16px;
  }
  .mobile-menu nav li + li {
    border-top: 1px solid var(--color-border);
  }
  .mobile-menu a.display {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 60px;
    font-size: 1.75rem;
    text-decoration: none;
  }
  .mobile-menu a.display svg {
    color: var(--color-muted);
    transition: transform var(--dur) var(--ease-out);
  }
  .mobile-menu a.display:hover svg {
    transform: translateX(3px);
    color: var(--color-ink);
  }
  .mobile-menu__follow {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    margin-top: 6px;
    padding: 0 18px;
    border-radius: 20px;
    background: var(--color-panel);
    font-weight: 500;
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .mobile-menu__follow--soon {
    color: var(--color-muted);
  }
  @media (max-width: 359px) {
    .mobile-menu__follow-tail {
      display: none;
    }
  }
  /* Subtle business contact row: small muted links, full-size tap targets */
  .mobile-menu__contact {
    border-top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 4px;
    padding: 0 6px 0 18px;
  }
  .mobile-menu__contact-label {
    color: var(--color-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .mobile-menu__contact ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }
  /* Narrow phones: links get their own line under the label */
  @media (max-width: 379px) {
    .mobile-menu__contact {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding: 8px 0 0 18px;
    }
    .mobile-menu__contact ul {
      margin-left: -8px;
    }
  }
  .mobile-menu__contact li + li::before {
    content: '·';
    color: var(--color-border);
    padding-inline: 2px;
  }
  .mobile-menu__contact a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 8px;
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition:
      color var(--dur-fast) ease,
      text-decoration-color var(--dur-fast) ease;
  }
  .mobile-menu__contact a:hover,
  .mobile-menu__contact a:active {
    color: var(--color-ink);
    text-decoration-color: currentColor;
  }
  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu:not([hidden]) {
      animation: menu-in 420ms var(--ease-out);
    }
    .mobile-menu:not([hidden]) nav li {
      animation: item-in 520ms var(--ease-out) both;
      animation-delay: calc(60ms + var(--i) * 45ms);
    }
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-10px) scale(0.98);
    }
  }
  @keyframes item-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @media (min-width: 960px) {
    .site-header__nav ul {
      display: flex;
    }
    .follow {
      display: inline-flex;
    }
    .menu-toggle,
    .mobile-menu,
    .menu-scrim {
      display: none !important;
    }
  }
  /* Phones at rest: bar sits inside the hero frame with even space above */
  @media (max-width: 959px) {
    .site-header:not([data-scrolled]):not([data-open]) .site-header__bar {
      padding-top: 10px;
    }
  }
  /* Phones: logo on the left, Menu on the right — no empty gap */
  @media (max-width: 959px) {
    .site-header__nav {
      display: none;
    }
    .site-header__brand {
      grid-column: 1;
      grid-row: 1;
      justify-content: flex-start;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const label = header.querySelector<HTMLElement>('[data-menu-label]')!;
  const menu = header.querySelector<HTMLElement>('[data-menu]')!;
  const scrim = header.querySelector<HTMLElement>('[data-menu-scrim]')!;

  // Morph into the oval once the header has left its resting spot over the hero.
  const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  function setOpen(open: boolean, returnFocus = false) {
    toggle.setAttribute('aria-expanded', String(open));
    label.textContent = open ? 'Close menu' : 'Open menu';
    menu.hidden = !open;
    scrim.hidden = !open;
    header.toggleAttribute('data-open', open);
    document.documentElement.classList.toggle('menu-open', open);
    if (open) menu.querySelector<HTMLElement>('a')?.focus();
    else if (returnFocus) toggle.focus();
  }

  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.hidden) setOpen(false, true);
  });
  scrim.addEventListener('click', () => setOpen(false));
  document.addEventListener('click', (e) => {
    if (!menu.hidden && !header.contains(e.target as Node)) setOpen(false);
  });
  matchMedia('(min-width: 960px)').addEventListener('change', (e) => e.matches && setOpen(false));
</script>
