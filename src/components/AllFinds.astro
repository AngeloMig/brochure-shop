---
import { site } from '../config/site';
import { products, activeCategories } from '../lib/catalog';
import SectionHead from './SectionHead.astro';
import ProductCard from './ProductCard.astro';
import CurrencySwitch from './CurrencySwitch.astro';
---

<section id="all-finds" class="section" aria-labelledby="all-finds-title" data-finds>
  <div class="container">
    <SectionHead id="all-finds-title" heading={site.allFinds.heading} text={site.allFinds.text} />

    <div class="toolbar">
      <div class="search">
        <label for="find-search" class="visually-hidden">Search finds by name</label>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="6" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
          <path d="m13 13 5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
        <input id="find-search" type="search" placeholder="Search finds" autocomplete="off" data-search />
      </div>

      <div class="chips" role="group" aria-label="Filter by category">
        <button class="chip" type="button" aria-pressed="true" data-chip="">All</button>
        {
          activeCategories.map((c) => (
            <button class="chip" type="button" aria-pressed="false" data-chip={c}>
              {c}
            </button>
          ))
        }
      </div>
    </div>

    <div class="meta">
      <p class="count" aria-live="polite" data-count>{products.length} finds</p>
      <CurrencySwitch />
    </div>

    <ul class="grid" role="list" data-grid data-reveal-stagger>
      {
        products.map((product) => (
          <li>
            <ProductCard product={product} />
          </li>
        ))
      }
    </ul>

    <div class="empty" hidden data-empty>
      <p class="display h3">No finds match</p>
      <p class="lede" data-empty-text>Try a different word or another category.</p>
      <button class="pill pill--secondary empty__btn" type="button" data-clear>
        <span class="pill__fill" aria-hidden="true"></span>
        <span class="pill__label">Clear search and filters</span>
      </button>
    </div>
  </div>
</section>

<style>
  .toolbar {
    display: grid;
    gap: 16px;
    margin-bottom: 20px;
  }
  .search {
    position: relative;
    max-width: 420px;
  }
  .search svg {
    position: absolute;
    left: 20px;
    top: 50%;
    translate: 0 -50%;
    color: var(--color-muted);
    pointer-events: none;
  }
  .search input {
    width: 100%;
    height: 52px;
    padding: 0 20px 0 50px;
    border: 1px solid var(--color-border);
    border-radius: 32px;
    background: var(--color-bg);
    font-size: var(--text-base); /* 16px prevents iOS zoom */
    transition: border-color var(--dur) var(--ease-out);
  }
  .search input::placeholder {
    color: var(--color-muted);
  }
  .search input:hover {
    border-color: color-mix(in srgb, var(--color-ink) 40%, var(--color-border));
  }
  .search input:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
    border-color: var(--color-ink);
  }

  .chips {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 4px var(--gutter);
    margin-inline: calc(-1 * var(--gutter));
    scrollbar-width: none;
  }
  .chips::-webkit-scrollbar {
    display: none;
  }
  .chip {
    flex: none;
    min-height: 44px;
    padding: 0 20px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    font-size: var(--text-sm);
    font-weight: 500;
    transition:
      background-color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out);
  }
  .chip:hover {
    border-color: var(--color-ink);
  }
  .chip[aria-pressed='true'] {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-on-dark);
  }

  .meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 20px;
  }
  .count {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap-cards);
  }
  .grid > li[hidden] {
    display: none;
  }
  @media (min-width: 900px) {
    .toolbar {
      grid-template-columns: minmax(280px, 380px) 1fr;
      align-items: center;
      gap: 24px;
    }
    .chips {
      flex-wrap: wrap;
      padding: 0;
      margin: 0;
      overflow: visible;
    }
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1200px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .empty {
    display: grid;
    justify-items: start;
    gap: 14px;
    padding: 56px 32px;
    border-radius: var(--radius-panel);
    background: var(--color-panel);
  }
  .empty[hidden] {
    display: none;
  }
  .empty__btn {
    margin-top: 8px;
    min-width: 0;
    justify-content: center;
  }
  .empty__btn:is(:hover, :focus-visible) {
    border-color: var(--color-ink);
    color: var(--color-on-dark);
    background-color: var(--color-ink);
    transition:
      border-color 300ms ease-in-out,
      color 300ms ease-in-out,
      background-color 0ms linear 380ms;
  }
  .empty__btn:is(:hover, :focus-visible) :global(.pill__fill) {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.2);
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-finds]')!;
  const search = root.querySelector<HTMLInputElement>('[data-search]')!;
  const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-chip]')];
  const items = [...root.querySelectorAll<HTMLElement>('[data-grid] > li')];
  const count = root.querySelector<HTMLElement>('[data-count]')!;
  const empty = root.querySelector<HTMLElement>('[data-empty]')!;
  const emptyText = root.querySelector<HTMLElement>('[data-empty-text]')!;
  const clear = root.querySelector<HTMLButtonElement>('[data-clear]')!;

  let category = '';

  const normalize = (s: string) =>
    s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').trim();

  function apply() {
    const q = normalize(search.value);
    let shown = 0;
    for (const li of items) {
      const card = li.firstElementChild as HTMLElement;
      const match =
        (!category || card.dataset.category === category) && (!q || normalize(card.dataset.name ?? '').includes(q));
      li.hidden = !match;
      if (match) shown++;
    }
    count.textContent = `${shown} ${shown === 1 ? 'find' : 'finds'}${category ? ` in ${category}` : ''}`;
    empty.hidden = shown > 0;
    if (shown === 0) {
      const parts = [q && `“${search.value.trim()}”`, category && `in ${category}`].filter(Boolean).join(' ');
      emptyText.textContent = `Nothing matches ${parts}. Try a different word or another category.`;
    }
  }

  function setCategory(value: string) {
    category = value;
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.chip === value)));
    apply();
  }

  search.addEventListener('input', apply);
  chips.forEach((chip) => chip.addEventListener('click', () => setCategory(chip.dataset.chip ?? '')));
  clear.addEventListener('click', () => {
    search.value = '';
    setCategory('');
    search.focus();
  });
</script>
