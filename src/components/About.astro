---
/**
 * About — modelled on the reference's story showcase. On desktop the section
 * pins while you scroll: your photo opens out from the middle of a row of
 * tiles to fill the screen, the side tiles drift away, and the story fades in
 * over it. Phones (and reduced-motion) get a calm stacked layout instead.
 * Edit the copy and photos in src/config/site.ts → about.
 */
import { site } from '../config/site';
import { isUsableUrl } from '../lib/links';
import { imageAttrs } from '../lib/images';
import Pill from './Pill.astro';

const { about } = site;
const center = imageAttrs(about.image, { widths: [800, 1400, 2000] });
const tiles = about.tiles.map((src) => imageAttrs(src, { ratio: 3 / 4, widths: [400, 640] }));
const [outerL, innerL, innerR, outerR] = tiles;
const side = [
  { img: outerL, cls: 'tile--outer', dir: -1 },
  { img: innerL, cls: 'tile--inner', dir: -1 },
  null, // centre slot
  { img: innerR, cls: 'tile--inner', dir: 1 },
  { img: outerR, cls: 'tile--outer', dir: 1 },
];
---

<section id="about" class="about" aria-labelledby="about-title" data-about>
  <div class="about__stage" data-about-stage>
    <div class="about__sticky">
      <div class="about__row" aria-hidden="true">
        {
          side.map((t) =>
            t ? (
              <div class:list={['tile', t.cls]} style={`--dir:${t.dir}`}>
                {t.img && (
                  <img src={t.img.src} srcset={t.img.srcset} sizes="20vw" alt="" loading="lazy" decoding="async" />
                )}
              </div>
            ) : (
              <div class="tile tile--slot" data-about-slot />
            ),
          )
        }
      </div>

      <div class="about__center" data-about-center>
        {
          center && (
            <img
              class="about__photo"
              src={center.src}
              srcset={center.srcset}
              sizes="100vw"
              alt={about.imageAlt}
              loading="lazy"
              decoding="async"
            />
          )
        }
        <div class="about__story">
          <p class="eyebrow about__eyebrow">{about.eyebrow}</p>
          <h2 id="about-title" class="display about__statement">{about.statement}</h2>
          {about.paragraphs.map((p) => <p class="about__text">{p}</p>)}
          <div class="about__actions">
            {
              isUsableUrl(site.tiktokProfileUrl) ? (
                <Pill href={site.tiktokProfileUrl} kind="external" variant="light" label={`Follow @${site.tiktokHandle}`} />
              ) : (
                <Pill label="" kind="external" variant="light" unavailableLabel="TikTok profile link coming soon" />
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    --p: 0; /* photo expansion 0 → 1 */
    --t: 0; /* story reveal 0 → 1 */
    margin-top: var(--section-space);
    overflow: clip;
  }

  /* ── Shared pieces ─────────────────────────────────────────── */
  .tile {
    border-radius: var(--radius-block);
    overflow: hidden;
    background: var(--color-panel);
  }
  .tile img,
  .about__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .about__center {
    position: relative;
    color: var(--color-on-dark);
  }
  .about__story {
    display: grid;
    justify-items: center;
    gap: 18px;
    text-align: center;
  }
  .about__eyebrow {
    color: rgb(255 255 255 / 0.75);
  }
  .about__statement {
    max-width: 18ch;
    font-size: clamp(1.75rem, 1rem + 3.4vw, 3.75rem);
    line-height: 1.02;
  }
  .about__text {
    max-width: 46ch;
    color: rgb(255 255 255 / 0.8);
    line-height: 1.6;
  }
  .about__actions {
    margin-top: 8px;
  }
  .about__actions :global(.pill--light) {
    --pill-fill: var(--color-accent);
    --pill-fg-hover: var(--color-on-accent);
  }
  .about__actions :global(.pill--unavailable) {
    --pill-fg: rgb(255 255 255 / 0.8);
    --pill-border: rgb(255 255 255 / 0.4);
  }

  /* ── Phones + reduced motion: photo with the story card overlapping it ── */
  .about__stage {
    padding-inline: var(--gutter);
  }
  .about__row {
    display: none;
  }
  .about__center {
    max-width: 720px;
    margin-inline: auto;
  }
  .about__photo {
    display: block;
    aspect-ratio: 4 / 5;
    max-height: 640px;
    border-radius: var(--radius-block);
    background: var(--color-panel);
  }
  .about__story {
    position: relative;
    z-index: 1;
    margin: -96px 12px 0;
    padding: 36px 22px 32px;
    border-radius: var(--radius-block);
    background: rgb(41 43 39 / 0.84);
    backdrop-filter: blur(24px) saturate(1.2);
    -webkit-backdrop-filter: blur(24px) saturate(1.2);
  }

  /* ── Desktop with motion: pinned scroll story ─────────────────── */
  @media (min-width: 900px) and (prefers-reduced-motion: no-preference) {
    .about__stage {
      position: relative;
      height: 240vh;
      padding: 0;
    }
    .about__sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      height: 100svh;
    }
    .about__row {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 24px;
    }
    .tile {
      flex: none;
      transform: translate3d(calc(var(--dir) * var(--p) * 40vw), 0, 0);
      opacity: calc(1 - var(--p) * 1.5);
      will-change: transform, opacity;
    }
    .tile--outer {
      width: clamp(150px, 13vw, 210px);
      aspect-ratio: 3 / 4;
    }
    .tile--inner {
      width: clamp(200px, 18vw, 290px);
      aspect-ratio: 3 / 4;
    }
    .tile--slot {
      width: var(--w0, 420px);
      height: var(--h0, 560px);
      visibility: hidden;
    }

    /* The centre is the full final frame, revealed through an animated clip */
    .about__center {
      position: absolute;
      inset: var(--inset, 24px);
      width: auto;
      max-width: none;
      max-height: none;
      aspect-ratio: auto;
      margin: 0;
      overflow: hidden;
      background: var(--color-panel);
      clip-path: inset(
        calc(var(--y0, 0px) * (1 - var(--p))) calc(var(--x0, 0px) * (1 - var(--p)))
          round var(--radius-block)
      );
      will-change: clip-path;
    }
    .about__photo {
      position: absolute;
      inset: 0;
      aspect-ratio: auto;
      max-height: none;
      border-radius: 0;
      transform: scale(calc(1.12 - var(--p) * 0.12));
      will-change: transform;
    }
    .about__center::after {
      content: '';
      position: absolute;
      inset: 0;
      background: rgb(28 29 26 / calc(var(--t) * 0.55));
    }
    .about__story {
      position: absolute;
      inset: 0;
      z-index: 1;
      align-content: center;
      max-width: none;
      margin: 0;
      padding: 48px;
      border-radius: 0;
      background: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      opacity: var(--t);
      transform: translate3d(0, calc((1 - var(--t)) * 24px), 0);
      pointer-events: none;
    }
    .about[data-story-on] .about__story {
      pointer-events: auto;
    }
    .about__statement {
      max-width: 20ch;
      font-size: clamp(2.5rem, 1rem + 3.6vw, 4.5rem);
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-about]');
  const stage = root?.querySelector<HTMLElement>('[data-about-stage]');
  const center = root?.querySelector<HTMLElement>('[data-about-center]');
  const pinned = matchMedia('(min-width: 900px) and (prefers-reduced-motion: no-preference)');

  if (root && stage && center) {
    let frame = 0;

    // Size the starting window (a portrait tile in the middle of the row).
    const measure = () => {
      if (!pinned.matches) return;
      const gutter = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--gutter')) || 24;
      const w = center.offsetWidth;
      const h = center.offsetHeight;
      const h0 = Math.min(h * 0.72, 600);
      const w0 = Math.min(h0 * 0.75, w * 0.32);
      root.style.setProperty('--inset', `${gutter}px`);
      root.style.setProperty('--w0', `${w0}px`);
      root.style.setProperty('--h0', `${(w0 * 4) / 3}px`);
      root.style.setProperty('--x0', `${(w - w0) / 2}px`);
      root.style.setProperty('--y0', `${(h - (w0 * 4) / 3) / 2}px`);
    };

    const ease = (x: number) => 1 - Math.pow(1 - x, 3);
    const clamp = (x: number) => Math.min(1, Math.max(0, x));
    const update = () => {
      frame = 0;
      if (!pinned.matches) {
        root.style.removeProperty('--p');
        root.style.removeProperty('--t');
        return;
      }
      const r = stage.getBoundingClientRect();
      const progress = clamp(-r.top / (r.height - innerHeight));
      const p = ease(clamp(progress / 0.6)); // photo opens over the first 60%
      const t = ease(clamp((progress - 0.5) / 0.3)); // story fades in from 50% → 80%
      root.style.setProperty('--p', p.toFixed(4));
      root.style.setProperty('--t', t.toFixed(4));
      root.toggleAttribute('data-story-on', t > 0.6);
    };
    const queue = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    measure();
    update();
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', () => (measure(), queue()));
    pinned.addEventListener('change', () => (measure(), queue()));
  }
</script>
