---
/**
 * 9:16 video card. Nothing from TikTok loads until the visitor taps play; then
 * the official embed player replaces the thumbnail. If the URL can't be
 * embedded (short link) the play button simply opens TikTok instead.
 */
import type { Video } from '../lib/types';
import { productsForVideo } from '../lib/catalog';
import { isUsableUrl, tiktokVideoId, tiktokEmbedSrc, external } from '../lib/links';
import Media from './Media.astro';

interface Props {
  video: Video;
}
const { video } = Astro.props;
const hasUrl = isUsableUrl(video.tiktokUrl);
const embedId = tiktokVideoId(video.tiktokUrl);
const related = productsForVideo(video)[0];
---

<article class="vcard" data-video-card data-video-id={video.id}>
  <div class="vcard__frame" data-frame>
    <Media
      src={video.thumbnail}
      alt=""
      ratio={9 / 16}
      sizes="(min-width: 1200px) 18vw, (min-width: 768px) 28vw, 58vw"
      class="vcard__thumb"
      fallbackLabel="Video thumbnail"
    />
    {
      embedId ? (
        <button
          class="vcard__play"
          type="button"
          data-embed-src={tiktokEmbedSrc(embedId)}
          data-embed-title={`TikTok video: ${video.caption}`}
        >
          <span class="vcard__icon" aria-hidden="true">
            <svg viewBox="0 0 8 10" width="14" height="17"><path d="M0 0v10l8-5z" fill="currentColor" /></svg>
          </span>
          <span class="visually-hidden">Play video: {video.caption}</span>
        </button>
      ) : hasUrl ? (
        <a class="vcard__play" href={video.tiktokUrl} {...external}>
          <span class="vcard__icon" aria-hidden="true">
            <svg viewBox="0 0 8 10" width="14" height="17"><path d="M0 0v10l8-5z" fill="currentColor" /></svg>
          </span>
          <span class="visually-hidden">Watch on TikTok: {video.caption} (opens in a new tab)</span>
        </a>
      ) : (
        <span class="vcard__soon">Video coming soon</span>
      )
    }
  </div>

  <div class="vcard__body">
    <p class="vcard__caption">{video.caption}</p>
    <div class="vcard__links">
      {
        hasUrl && (
          <a class="text-link" href={video.tiktokUrl} {...external}>
            Watch on TikTok<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        )
      }
      {
        related && (
          <button class="vcard__related" type="button" data-quickview={related.id} aria-haspopup="dialog">
            <span class="vcard__related-label">Featured find</span>
            <span class="vcard__related-name">{related.name}</span>
          </button>
        )
      }
    </div>
  </div>
</article>

<style>
  .vcard {
    display: grid;
    gap: 14px;
    align-content: start;
  }
  .vcard__frame {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: 20px;
    overflow: hidden;
    background: var(--color-panel);
  }
  .vcard__frame :global(.vcard__thumb) {
    position: absolute;
    inset: 0;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .vcard:hover .vcard__frame :global(.vcard__thumb) {
    transform: scale(1.03);
  }
  .vcard__frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: #000;
  }
  .vcard__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--color-ink);
  }
  .vcard__icon {
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    padding-left: 4px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.92);
    transition: transform var(--dur) var(--ease-spring);
  }
  .vcard__play:hover .vcard__icon {
    transform: scale(1.08);
  }
  .vcard__play:focus-visible {
    outline-offset: -4px;
    border-radius: 20px;
  }
  .vcard__soon {
    position: absolute;
    left: 12px;
    bottom: 12px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.92);
    font-size: var(--text-xs);
    font-weight: 500;
  }
  .vcard__body {
    display: grid;
    gap: 2px;
  }
  .vcard__caption {
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.4;
  }
  .vcard__links {
    display: grid;
    justify-items: start;
  }
  .vcard__related {
    display: grid;
    min-height: 44px;
    align-content: center;
    text-align: left;
    font-size: 0.8125rem;
    line-height: 1.35;
  }
  .vcard__related-label {
    color: var(--color-muted);
  }
  .vcard__related-name {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
  }
  .vcard__related:hover .vcard__related-name {
    text-decoration-color: currentColor;
  }
</style>

<script>
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>('button[data-embed-src]');
    if (!btn) return;
    const frame = btn.closest('[data-frame]')!;
    const iframe = document.createElement('iframe');
    iframe.src = btn.dataset.embedSrc!;
    iframe.title = btn.dataset.embedTitle ?? 'TikTok video';
    iframe.allow = 'autoplay; encrypted-media; fullscreen; picture-in-picture';
    iframe.allowFullscreen = true;
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    btn.remove();
    frame.appendChild(iframe);
    (window as any).beaTrack?.('Video play', { video: btn.closest<HTMLElement>('[data-video-id]')?.dataset.videoId ?? '' });
    iframe.focus();
  });
</script>
