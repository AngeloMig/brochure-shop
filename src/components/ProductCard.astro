---
/**
 * Product card. The product name is a button that opens the quick view; a
 * pseudo-element stretches its hit area over the whole card so tapping the
 * image works too. The TikTok link sits above that layer — links are never
 * nested inside other interactive elements.
 */
import type { Product } from '../lib/types';
import { videosForProduct } from '../lib/catalog';
import { isUsableUrl, outbound, external } from '../lib/links';
import { imageAttrs } from '../lib/images';
import Media from './Media.astro';
import Pill from './Pill.astro';
import Price from './Price.astro';

interface Props {
  product: Product;
  variant?: 'featured' | 'grid';
  headingLevel?: 'h3' | 'h4';
}

const { product, variant = 'grid', headingLevel: Heading = 'h3' } = Astro.props;
const related = videosForProduct(product);
const clip = related[0];
const clipThumb = clip ? imageAttrs(clip.thumbnail, { ratio: 9 / 16, widths: [120] }) : null;
const reviewUrl = related.find((v) => isUsableUrl(v.tiktokUrl))?.tiktokUrl;
/** Second photo, crossfaded in on hover (desktop) — the first `gallery` image. */
const altImage = product.gallery?.[0];
const sizes =
  variant === 'featured'
    ? '(min-width: 1200px) 32vw, (min-width: 768px) 45vw, 80vw'
    : '(min-width: 1200px) 24vw, (min-width: 900px) 32vw, 50vw';
---

<article
  class:list={['card', `card--${variant}`]}
  data-product-card
  data-id={product.id}
  data-name={product.name.toLowerCase()}
  data-category={product.category}
>
  <div class="card__media">
    <Media
      src={product.image}
      alt={product.imageAlt ?? product.name}
      ratio={1}
      sizes={sizes}
      class="card__img"
      fallbackSrc={product.imageFallback}
      fallbackLabel={product.name}
    />
    {
      altImage && (
        <Media src={altImage} alt="" ratio={1} sizes={sizes} class="card__img card__img--alt" fallbackLabel="" />
      )
    }
    {product.badge && <span class="card__badge">{product.badge}</span>}
    {
      variant === 'featured' && clipThumb && (
        <span class="card__clip" aria-hidden="true">
          <img src={clipThumb.src} alt="" loading="lazy" decoding="async" data-fallback />
          <svg viewBox="0 0 8 10" width="8" height="10">
            <path d="M0 0v10l8-5z" fill="currentColor" />
          </svg>
        </span>
      )
    }
    <span class="card__peek" aria-hidden="true">Quick view</span>
  </div>

  <div class="card__body">
    <Heading class="card__name">
      <button class="card__open" type="button" data-quickview={product.id} aria-haspopup="dialog">
        {product.name}
        <span class="visually-hidden">— quick view</span>
      </button>
    </Heading>
    <p class="card__price"><Price usd={product.price} /></p>

    <div class="card__actions">
      {
        variant === 'featured' ? (
          <>
            <Pill
              href={product.affiliateUrl}
              kind="affiliate"
              label="View on TikTok"
              size="sm"
              srContext={product.name}
            />
            {reviewUrl && (
              <a class="text-link" href={reviewUrl} {...external}>
                Watch my review
                <span class="visually-hidden">of {product.name} on TikTok (opens in a new tab)</span>
              </a>
            )}
          </>
        ) : isUsableUrl(product.affiliateUrl) ? (
          <a class="card__tiktok text-link" href={product.affiliateUrl} {...outbound}>
            View on TikTok
            <span class="visually-hidden">: {product.name} (opens in a new tab)</span>
            <svg viewBox="0 0 8 10" width="7" height="9" aria-hidden="true">
              <path d="M0 0v10l8-5z" fill="currentColor" />
            </svg>
          </a>
        ) : (
          <span class="card__tiktok card__tiktok--soon">Link coming soon</span>
        )
      }
    </div>
  </div>
</article>

<style>
  .card {
    transition: scale 260ms cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radius-panel);
    background: var(--color-panel);
    overflow: hidden;
    isolation: isolate;
    /* clip-path keeps zoomed / blended images inside the rounded corners in every browser */
    clip-path: inset(0 round var(--radius-panel));
  }
  /* Press feedback when a card is tapped/clicked */
  /* uses `scale` (not transform) so it never fights the scroll-reveal animation */
  .card:has(.card__open:active) {
    scale: 0.975;
    transition: scale 120ms ease-out;
  }
  @media (prefers-reduced-motion: reduce) {
    .card:has(.card__open:active) {
      scale: 1;
    }
  }
  .card__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-panel) var(--radius-panel) 0 0;
    transform: translateZ(0);
  }
  .card__media :global(.card__img) {
    background: var(--color-panel);
  }
  .card__media :global(.card__img img) {
    mix-blend-mode: multiply; /* white product backgrounds melt into the panel */
    transition: transform 700ms var(--ease-out);
  }
  @media (hover: hover) {
    .card:not(:has(.card__img--alt)):hover .card__media :global(.card__img img) {
      transform: scale(1.03);
    }
  }
  /* Second photo: hidden until hover on devices that can hover */
  .card__media :global(.card__img--alt) {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 500ms var(--ease-out);
  }
  @media (hover: hover) {
    .card:hover .card__media :global(.card__img--alt) {
      opacity: 1;
    }
  }

  .card__badge {
    position: absolute;
    top: 16px;
    left: 16px;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .card__clip {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 46px;
    aspect-ratio: 9 / 16;
    border-radius: var(--radius-thumb);
    overflow: hidden;
    background: var(--color-panel-strong);
    box-shadow: 0 0 0 3px var(--color-bg);
    color: var(--color-on-dark);
  }
  .card__clip img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card__clip svg {
    position: absolute;
    inset: 0;
    margin: auto;
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.4));
  }

  .card__peek {
    position: absolute;
    left: 50%;
    bottom: 16px;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    font-size: var(--text-xs);
    font-weight: 500;
    opacity: 0;
    transform: translate(-50%, 6px);
    transition:
      opacity var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
    pointer-events: none;
  }
  @media (hover: hover) {
    .card:hover .card__peek,
    .card:has(.card__open:focus-visible:not([data-quiet-focus])) .card__peek {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }

  .card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 6px;
    padding: 20px 20px 22px;
  }
  .card__name {
    font-size: var(--text-base);
    font-weight: 500;
    line-height: 1.35;
  }
  .card__price {
    font-size: var(--text-base);
    line-height: 1.4;
  }
  .card__price :global(.price--none) {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .card--grid .card__price {
    font-size: var(--text-sm);
  }
  .card--grid .card__price :global(.price--none) {
    font-size: 0.8125rem;
  }
  .card__open {
    text-align: left;
    font-weight: inherit;
    line-height: inherit;
  }
  .card__open::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }
  .card__open:focus-visible {
    outline: none;
  }
  /* Keyboard focus ring sits inside the rounded edge so carousels can't crop it */
  .card:has(.card__open:focus-visible:not([data-quiet-focus])) {
    outline: 2px solid var(--color-focus);
    outline-offset: -2px;
  }
  .card__actions {
    position: relative;
    z-index: 2; /* above the stretched quick-view button */
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 20px;
    margin-top: auto;
    padding-top: 14px;
  }

  /* Featured: roomier, matches the reference's large top-pick panels */
  @media (min-width: 1200px) {
    .card--featured .card__body {
      padding: 24px 24px 26px;
    }
    .card--featured .card__name {
      font-size: var(--text-md);
    }
  }

  /* Grid: compact for two-up on phones */
  .card--grid {
    --radius-panel: 20px;
    border-radius: 20px;
  }
  .card--grid .card__badge {
    top: 10px;
    left: 10px;
  }
  .card--grid .card__body {
    padding: 14px 14px 8px;
  }
  .card--grid .card__name {
    font-size: var(--text-sm);
  }
  .card--grid .card__actions {
    padding-top: 4px;
  }
  .card__tiktok {
    font-size: 0.8125rem;
  }
  .card__tiktok--soon {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-muted);
  }
  @media (min-width: 768px) {
    .card--grid {
      --radius-panel: 24px;
      border-radius: 24px;
    }
    .card--grid .card__body {
      padding: 18px 20px 10px;
    }
  </style>
